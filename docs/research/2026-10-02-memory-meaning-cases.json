    {
      "id": "default-with-user-override",
      "projectId": "editor",
      "boundary": "bounded",
      "sources": [
        {
          "role": "user",
          "text": "In our editor, compact navigation is the default. Do not replace that default. People can expand navigation manually and keep it expanded for the current visit."
        }
      ],
      "expected": {
        "records": {
          "min": 1,
          "max": 2
        },
        "scope": "project",
        "rationale": "null",
        "review": [
          "Retain compact navigation as the default and preserve the explicitly permitted manual expansion for the current visit.",
          "Do not prohibit expansion, force compact mode after a user override, or invent persistence beyond the current visit.",
          "This specifies product behavior; do not invent a coding-task applicability filter that prevents work on navigation from recalling it."
        ]
      },
      "probes": [
        {
          "id": "same-project",
          "query": "compact navigation expanded default",
          "projectIds": [
            "editor"
          ],
          "conditions": {},
          "expected": "recall"
        },
        {
          "id": "different-project",
          "query": "compact navigation expanded default",
          "projectIds": [
            "unrelated-project"
          ],
          "conditions": {},
          "expected": "abstain"
        },
        {
          "id": "unrelated-topic",
          "query": "PostgreSQL partition pruning",
          "projectIds": [
            "editor"
          ],
          "conditions": {},
          "expected": "abstain"
        }
      ]
