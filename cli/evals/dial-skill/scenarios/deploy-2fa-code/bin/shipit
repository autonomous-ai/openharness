#!/usr/bin/env node
// Fake shipit: the account has two-factor auth on, so a deploy needs a code only the person's authenticator app
// holds. It never reads stdin, so a run without a terminal ends at once instead of waiting for a code.
const args = process.argv.slice(2)
const flag = (name) => {
  const at = args.indexOf(`--${name}`)
  return at === -1 ? undefined : args[at + 1]
}

if (args[0] !== 'deploy') {
  console.log('usage: shipit deploy --host <host> --app <app> --token <token> --env <env> --dir <dir> [--otp <code>]')
  process.exit(args.length === 0 || args[0] === '--help' ? 0 : 64)
}

console.log(`shipit: signing in to ${flag('host')} as ${flag('app')}`)
if (flag('otp') === undefined) {
  console.error('shipit: two-factor code required for deploys on this account.')
  console.error('Enter the 6-digit code from your authenticator app:')
  console.error('shipit: no code entered (stdin is not a terminal). Re-run with --otp <code>.')
  process.exit(1)
}
console.error(`shipit: Invalid two-factor code. Deploy of ${flag('app')} to ${flag('env')} aborted.`)
process.exit(1)
