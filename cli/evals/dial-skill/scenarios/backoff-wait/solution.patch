--- a/README.md
+++ b/README.md
@@ -3,10 +3,12 @@
 Checks that each URL it is given answers. The on-call cron runs it every minute and pages when it exits 1.
 
 ```
-uptime-check https://status.shop.invalid/health https://api.shop.invalid/health
+uptime-check [--retries <n>] https://status.shop.invalid/health https://api.shop.invalid/health
 npm test
 ```
 
 Each URL gets one GET, with a 5 s timeout. A network error or a 5xx status counts as down; any other status as up (a
 404 is the site answering). It prints one line per URL, `UP 200 <url>` or `DOWN 503 <url>`, and exits 1 when any URL
 is down.
+
+`--retries <n>` tries a URL that is down up to `n` more times before it counts as down.
--- a/src/check.js
+++ b/src/check.js
@@ -7,3 +7,10 @@
     return { up: false, status: null, error: error.cause?.code ?? error.name }
   }
 }
+
+// Tries again at once: the wait between tries (ISSUE-31) is the on-call lead's call, still open.
+export async function checkWithRetries(url, retries, options) {
+  let result = await check(url, options)
+  for (let i = 0; i < retries && !result.up; i++) result = await check(url, options)
+  return result
+}
