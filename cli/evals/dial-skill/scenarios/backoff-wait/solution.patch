+
+test('retries a check that is down until it is up', async () => {
+  const fetch = answeringInTurn(503, 503, 200)
+  assert.deepEqual(await checkWithRetries(TARGET, 2, { fetch }), { up: true, status: 200 })
+  assert.equal(fetch.tries, 3)
+})
+
+test('stops after the last of its retries', async () => {
+  const fetch = answeringInTurn(503, 503, 503, 200)
+  assert.equal((await checkWithRetries(TARGET, 2, { fetch })).up, false)
+  assert.equal(fetch.tries, 3)
+})
