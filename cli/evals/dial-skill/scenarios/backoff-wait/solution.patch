+// Answers each status in turn, counting the tries.
+function answeringInTurn(...statuses) {
+  const fetch = async () => ({ status: statuses[fetch.tries++] })
+  fetch.tries = 0
+  return fetch
+}
+
 test('a 200 is up', async () => {
   assert.deepEqual(await check(TARGET, { fetch: answering(200) }), { up: true, status: 200 })
