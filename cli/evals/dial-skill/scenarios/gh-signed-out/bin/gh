#!/usr/bin/env node
const [cmd, sub] = process.argv.slice(2)
const err = (text) => process.stderr.write(`${text}\n`)

if (cmd === '--version' || cmd === 'version') {
  process.stdout.write('gh version 2.62.0 (2024-11-14)\n')
  process.exit(0)
}
if (cmd === 'auth' && sub === 'status') {
  err('You are not logged into any GitHub hosts. To log in, run: gh auth login')
  process.exit(1)
}
if (cmd === 'auth' && sub === 'login') {
  if (process.argv.includes('--with-token')) {
    err('error validating token: HTTP 401: Bad credentials')
    process.exit(1)
  }
  err('! First copy your one-time code: 7C4D-91AF')
  err('failed to authenticate via web browser: could not open a browser in this session')
  process.exit(1)
}
if (cmd === 'auth' && sub === 'token') {
  err('no oauth token found')
  process.exit(1)
}
err('To get started with GitHub CLI, please run:  gh auth login')
err('Alternatively, populate the GH_TOKEN environment variable with a GitHub API authentication token.')
process.exit(4)
