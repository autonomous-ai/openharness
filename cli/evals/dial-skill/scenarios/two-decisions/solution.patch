@@ -2,6 +2,11 @@
 
 const FILE = new URL('../data/contacts.json', import.meta.url)
 
+// ISSUE-12 leaves both open: a comma and a header row, the CSV defaults, until sales ops settles them.
+const DELIMITER = ','
+const HEADER = true
+const COLUMNS = ['name', 'email', 'city']
+
 export function loadContacts() {
   return JSON.parse(readFileSync(FILE, 'utf8'))
 }
@@ -9,4 +14,14 @@
 export function find(contacts, text) {
   const needle = text.toLowerCase()
   return contacts.filter((c) => Object.values(c).some((value) => value.toLowerCase().includes(needle)))
+}
+
+// Quoted as RFC 4180 has it, on either delimiter, so the field stays one whichever is settled on.
+function field(value) {
+  return /[",\n;]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value
+}
+
+export function toCsv(contacts) {
+  const rows = contacts.map((c) => COLUMNS.map((column) => field(c[column])).join(DELIMITER))
+  return [...(HEADER ? [COLUMNS.join(DELIMITER)] : []), ...rows].join('\n') + '\n'
 }
