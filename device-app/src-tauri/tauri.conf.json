{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Device",
  "identifier": "ai.autonomous.harness.device",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harness",
        "width": 420,
        "height": 320,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "bundleName": "Harness",
      "entitlements": "Entitlements.plist",
      "files": { "Resources/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://storage.googleapis.com/s3-autonomous-upgrade-3/harness/device/metadata.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MzlCRkNDNjg3QjFGNjIKUldSaUgzdG96TDg1UjdIaUhrOUZJQWF1Q1BMUGVyV0crMmNZZ0ZMWkx1QWp0dS9UbE9IcXAwdjkK",
      "requireSignedVersion": true
    }
  }
}
