{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Device",
  "identifier": "ai.autonomous.harness.device",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harness Device",
        "width": 420,
        "height": 320,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
