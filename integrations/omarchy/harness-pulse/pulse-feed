#!/usr/bin/env python3
"""pulse-feed: poll the local Harness daemon's attention feed and print one JSON line per poll.

Tries the Unix socket first (~/.harness/cli/data/daemon-<port>.sock, HTTP over AF_UNIX), then
127.0.0.1:<port>. Exit 0 on a clean stop, 3 when the daemon cannot be reached for a whole
minute. Never prints anything that is not a JSON object.
"""
import argparse
import http.client
import json
import os
import socket
import sys
import time

PORT = int(os.environ.get("HARNESS_PORT", "18473"))
SOCK = os.path.expanduser(os.environ.get("HARNESS_SOCKET", f"~/.harness/cli/data/daemon-{PORT}.sock"))
PATH = "/api/attention"
UNREACHABLE_LIMIT_SEC = 60


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout=2.0):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self.unix_path)
        self.sock = s


def fetch_once():
    errors = []
    conns = []
    if os.path.exists(SOCK):
        conns.append(("unix", lambda: UnixHTTPConnection(SOCK)))
    conns.append(("tcp", lambda: http.client.HTTPConnection("127.0.0.1", PORT, timeout=2.0)))
    for name, make in conns:
        try:
            c = make()
            c.request("GET", PATH, headers={"Host": f"127.0.0.1:{PORT}", "Accept": "application/json"})
            r = c.getresponse()
            body = r.read()
            c.close()
            if r.status != 200:
                errors.append(f"{name}: HTTP {r.status}")
                continue
            return json.loads(body.decode("utf-8", "replace")), None
        except (OSError, http.client.HTTPException, ValueError) as e:
            errors.append(f"{name}: {e.__class__.__name__}")
    return None, "; ".join(errors) or "unreachable"


def stop_all():
    """Panic stop: POST /api/stop-all. Prints one JSON line, exit 0 on success, 1 otherwise."""
    headers = {"Host": f"127.0.0.1:{PORT}", "Content-Type": "application/json", "x-adapter-local": "1"}
    conns = []
    if os.path.exists(SOCK):
        conns.append(lambda: UnixHTTPConnection(SOCK))
    conns.append(lambda: http.client.HTTPConnection("127.0.0.1", PORT, timeout=5.0))
    for make in conns:
        try:
            c = make()
            c.request("POST", "/api/stop-all", body="{}", headers=headers)
            r = c.getresponse()
            body = r.read().decode("utf-8", "replace")
            c.close()
            print(body, flush=True)
            return 0 if r.status == 200 else 1
        except (OSError, http.client.HTTPException):
            continue
    print(json.dumps({"error": "unreachable"}), flush=True)
    return 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--interval", type=float, default=1.0)
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--stop-all", action="store_true")
    a = ap.parse_args()
    if a.stop_all:
        sys.exit(stop_all())
    interval = max(0.5, a.interval)
    down_since = None
    while True:
        data, err = fetch_once()
        if data is not None:
            down_since = None
            out = {"hostname": data.get("hostname", ""), "machineId": data.get("machineId", ""),
                   "at": data.get("at", int(time.time() * 1000)), "agents": data.get("agents", []),
                   "alerts": data.get("alerts", []), "subscriptions": data.get("subscriptions")}
        else:
            down_since = down_since or time.time()
            out = {"error": err, "agents": []}
            if time.time() - down_since > UNREACHABLE_LIMIT_SEC:
                print(json.dumps(out), flush=True)
                sys.exit(3)
        print(json.dumps(out), flush=True)
        if a.once:
            return
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:
        sys.exit(0)
