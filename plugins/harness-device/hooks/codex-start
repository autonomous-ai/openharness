#!/bin/sh
# Codex runs this when a session starts, resumes, is cleared or compacted. The launcher prints the line that tells the
# agent about the dial, as SessionStart JSON, or nothing. Codex adds what a SessionStart hook prints to the model's
# request, as JSON or as plain text (the spike, codex-cli 0.172.0), so only the line the launcher shapes passes on: an
# older or foreign launcher's usage, another hook's JSON or anything on stderr is dropped, and the exit is always 0. The
# hook decides nothing.
# ~/.local/bin first: the installer puts the launcher there, and an app started from the Dock may not have it on PATH.
#
# codex.json's command is read by two shells, as for hooks/codex-asked: off Windows the first line execs this script;
# on Windows PowerShell runs the second line, the same lookup and the same check on what the launcher prints.
#
# With no launcher the input is read whole all the same, as hooks/start does, so Codex's write of it never meets a
# closed pipe.
prefix='{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":'
out=
if [ -x "$HOME/.local/bin/harness" ]; then
  out=$("$HOME/.local/bin/harness" device codex start 2>/dev/null)
elif command -v harness >/dev/null 2>&1; then
  out=$(harness device codex start 2>/dev/null)
else
  cat >/dev/null
fi
case "$out" in
  "$prefix"*) printf '%s\n' "$out" ;;
esac
exit 0
