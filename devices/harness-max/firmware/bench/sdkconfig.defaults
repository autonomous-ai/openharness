# The product's (../sdkconfig.defaults) chip, CPU, flash, PSRAM, cache and compiler settings, so the numbers are the
# product's. None of its peripherals, OTA, rollback or crash records: the bench touches nothing of the board it runs on
# and writes no flash. ESP-IDF reads this file only when it creates sdkconfig: delete bench/sdkconfig after a change.
CONFIG_IDF_TARGET="esp32p4"

# --- Silicon revision: v3.x, as the product ---
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# --- Flash (16 MB) and the product's partition table, so the size check is ota_1's (0x7E0000) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# --- FreeRTOS, CPU, main task ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Compiler: the product's optimisation, assertions and frame pointer (they all change the code timed) ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# --- PSRAM (32 MB hex at 200 MHz, code and read-only data executing from it), as the product ---
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- Console on the USB-Serial-JTAG (the Pro's USB-C port), nothing on a UART ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- A wedged bench reboots, which the Pro's bootloader turns into a return to the Pro's own image ---
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_DEBUG_OCDAWARE=n
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
