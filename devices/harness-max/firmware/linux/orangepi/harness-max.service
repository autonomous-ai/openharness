# Harness Max on the Orange Pi 4 Pro's 1480 x 320 bar (DRM/KMS, no X), started through the Phase 0 boot wrapper
# (/usr/local/sbin/phase0-flutter-start) for its fbcon unbind, HDMI hpd_mask and start guard. Installed by
# deploy-orangepi.sh as /etc/systemd/system/harness-max.service.
#
# No [Install]: the board still boots into Near. Starting this stops Near and starting Near stops this (Conflicts=
# works both ways): `near-demo` on the Mac, or `sudo systemctl start near-app`, puts Near back. Near's voice service
# holds the USB microphone, so it stops too; near-app's Wants= brings it back with Near.
[Unit]
Description=Harness Max on the bar display (DRM/KMS)
Conflicts=near-app.service near-voice.service phase0-flutter.service lightdm.service
# Ordering against the conflicting UIs makes systemd finish stopping them before this starts: one DRM master at a time.
After=systemd-udevd.service near-app.service near-voice.service phase0-flutter.service lightdm.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# Its own guard file: a hung Max start skips only the next Max start, never Near's boot.
Environment=PHASE0_GUARD=/var/lib/harness-max/start-pending
# Dumb buffers only: the GPU module is not needed.
Environment=PHASE0_MODPROBE=
# The USB microphone: the board's default card is its codec, which has no microphone wired.
Environment=HARNESS_MAX_MIC=plughw:CARD=Device,DEV=0
# --usb, --live or --demo, from ~/harness-max/mode.env (written by deploy-orangepi.sh).
Environment=HARNESS_MAX_ARGS=--usb
EnvironmentFile=-/home/orangepi/harness-max/mode.env
# The USB gadget the Mac's daemon finds (with --usb; any other mode takes it down), made as root before the app opens
# its port, and taken down when the app stops so the Mac sees the bar only while it runs.
ExecStartPre=/usr/local/sbin/harness-max-usb $HARNESS_MAX_ARGS
ExecStopPost=/usr/local/sbin/harness-max-usb --down
# The wrapper runs this with sh, which expands $HARNESS_MAX_ARGS; exec keeps the wrapper's SIGTERM going to the app.
Environment="PHASE0_APP_CMD=exec setpriv --reuid=orangepi --regid=orangepi --init-groups env HOME=/home/orangepi /home/orangepi/harness-max/bin/harness-max $HARNESS_MAX_ARGS"
# The A76 pair (cpu6, cpu7): the bar's scaled paint takes half the time it takes on the A55 cores.
CPUAffinity=6 7
# The pair at its top clock while the bar runs, as the ESP32-P4 runs at one clock. The image's ondemand governor
# (/etc/default/cpufrequtils) looks every 200 ms, so a tap after a rest painted its first frames at 416 MHz: 50-57 ms
# each, where 2 GHz takes 10-12 (measured 2026-11-20). The governor the pair had comes back when the bar stops.
ExecStartPre=-/bin/sh -c 'g=/sys/devices/system/cpu/cpu6/cpufreq/scaling_governor; [ -w "$$g" ] || exit 0; [ -s /run/harness-max-governor ] || cat "$$g" > /run/harness-max-governor; echo performance > "$$g"'
ExecStopPost=-/bin/sh -c 'g=/sys/devices/system/cpu/cpu6/cpufreq/scaling_governor; [ -s /run/harness-max-governor ] && [ -w "$$g" ] && cat /run/harness-max-governor > "$$g"; rm -f /run/harness-max-governor'
ExecStart=/usr/local/sbin/phase0-flutter-start
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
# Only the wrapper gets SIGTERM; it stops the app and clears the guard (see phase0-flutter.service).
KillMode=mixed
