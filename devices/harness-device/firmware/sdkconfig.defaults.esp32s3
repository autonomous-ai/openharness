# The round dial (ESP32-S3-Touch-AMOLED-1.75C), everything specific to the silicon.
#
# CONFIG_IDF_TARGET lives in sdkconfig.defaults — see the note there. This file is
# kept rather than folded in because IDF's per-target mechanism is what applies it, and a value that
# names a pin count, a PSRAM mode or a CPU clock belongs on that side of the line.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM (ESP32-S3R8 = 8MB octal PSRAM) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y


# --- Kernel, heap and ringbuffer code runs from flash (cached), not IRAM ---
# These keys exist only when the flash cache stays on during flash operations. SPI_FLASH_CACHE_NO_DISABLE is a
# local macro in esp-idf components/spi_flash/spi_flash_os_func_app.c, true here because CONFIG_SPIRAM_FETCH_INSTRUCTIONS
# and CONFIG_SPIRAM_RODATA are both y (code and rodata run from PSRAM, the cache is never disabled). Frees ~24 KB of DIRAM.
# HEAP_PLACE_FUNCTION_INTO_FLASH also turns off SPI_MASTER_ISR_IN_IRAM (esp_driver_spi's Kconfig depends on
# !HEAP_PLACE_FUNCTION_INTO_FLASH), so the display's QSPI done ISR runs through the PSRAM cache. If the dial A/B
# shows a frame-time regression, drop HEAP_PLACE_FUNCTION_INTO_FLASH first.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
