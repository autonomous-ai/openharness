# ESP-IDF build output & downloaded components (regenerated by idf.py)
build/
# ...but not Claude's builder art (gen_pets.py reads it; the folder is named for the scene, not a build output)
!assets/pets/claude/build/
managed_components/
.cache/
# dependencies.lock is TRACKED (2026-09-17): it is the exact component set the release was built and
# flashed with. Ignoring it let every fresh checkout resolve the manifest anew — and the day LVGL 9.6.0
# landed on the registry, a fresh build stopped booting. Regenerate it on purpose with
# `idf.py update-dependencies`, and commit the change with the reason.

# Generated config. sdkconfig.defaults is the tracked source of truth; CMakeLists.txt regenerates
# sdkconfig whenever the defaults hash changes (see the comment there), leaving the old one as
# sdkconfig.superseded.
# sdkconfig.defaults + sdkconfig.defaults.esp32s3 stay TRACKED — they are the source of truth;
# everything generated from them does not.
sdkconfig
sdkconfig.old
sdkconfig.superseded
sdkconfig.defaults.stamp

# The release build dir (scripts/upload-firmware.sh, scripts/flash-station.sh).
build-prod/

# Leftovers from older builds that may still sit in a checkout: the two-board build dirs and configs,
# and the Wi-Fi provisioning header, which held a password. Kept ignored so `git add -A` never takes them.
build.dial/
build.pro/
sdkconfig.dial*
sdkconfig.pro*
main/provisioned_config.h*

# Design mockups: HTML frames used to agree on a layout BEFORE writing code. They are a
# conversation, not a build input — nothing here compiles or ships.
mockup/
build-probe/
