datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Explicitly published, portable single-session snapshots. Live shares remain a separate protocol.
model CommunityHarness {
  id            String   @id @default(uuid()) @map("_id")
  autonomousEnv String   @default("prod")
  authorId      String
  authorName    String
  title         String
  description   String
  category      String
  engine        String
  harnessId     String?
  viewerPath    String
  files         Json
  conversation  Json
  cover         String?
  forkedFrom    String?
  credits       Json     @default("[]")
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  // Set when its author edits it (routes/communityEdit.ts); never on publishing.
  updatedAt     DateTime?
  // Its likes, moved with each one saved (lib/communityLikes.ts) and reconciled at worker boot: what a
  // popular feed orders by, instead of counting every publication's likes for each page.
  likeCount     Int      @default(0)

  @@index([autonomousEnv, deletedAt, createdAt])
  @@index([autonomousEnv, deletedAt, likeCount, createdAt])
  @@index([autonomousEnv, authorId])
  @@index([autonomousEnv, forkedFrom])
  @@index([autonomousEnv, category, deletedAt, createdAt])
  @@map("community_harnesses")
}

model CommunityLike {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  autonomousEnv String   @default("prod")
  harnessId     String
  userId        String
  createdAt     DateTime @default(now())

  @@unique([autonomousEnv, harnessId, userId])
  @@index([autonomousEnv, harnessId])
  // A trending feed reads only the last week's likes.
  @@index([autonomousEnv, createdAt])
  @@map("community_likes")
}

model CommunityComment {
  id            String   @id @default(uuid()) @map("_id")
  autonomousEnv String   @default("prod")
  harnessId     String
  userId        String
  authorName    String
  body          String
  clientId      String
  parentId      String?
  parentAuthorName String?
  createdAt     DateTime @default(now())

  @@unique([autonomousEnv, harnessId, userId, clientId])
  @@index([autonomousEnv, harnessId, createdAt])
  @@index([autonomousEnv, userId, createdAt])
  @@map("community_comments")
}

/// One reader's report of a publication or a comment (lib/communityReports.ts). It hides that one from
/// its reader at once; reports from three readers hide it from everyone (CommunityHidden).
model CommunityReport {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  autonomousEnv String   @default("prod")
  targetType    String   // 'harness' | 'comment'
  targetId      String
  harnessId     String   // the publication, or the one the comment is on
  userId        String
  reason        String
  createdAt     DateTime @default(now())

  @@unique([autonomousEnv, targetType, targetId, userId])
  @@index([autonomousEnv, userId, targetType])
  @@index([autonomousEnv, targetType, targetId, createdAt])
  @@map("community_reports")
}

/// A publication or comment hidden from everyone after reports, until a reviewer restores it (kept,
/// with `restoredAt`: only reports after that count again) or removes it.
model CommunityHidden {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  autonomousEnv String    @default("prod")
  targetType    String
  targetId      String
  harnessId     String
  createdAt     DateTime  @default(now())
  restoredAt    DateTime?

  @@unique([autonomousEnv, targetType, targetId])
  @@index([autonomousEnv, targetType, restoredAt])
  @@map("community_hidden")
}

/// Something that happened to a creator's work on the Hub, for their bell (lib/communityNotifications.ts):
/// a comment on their harness, a reply to their comment, a fork of their harness. It names who did it and
/// where, never what they wrote.
model CommunityNotification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  autonomousEnv String    @default("prod")
  userId        String    // who is told
  kind          String    // 'comment' | 'reply' | 'fork'
  harnessId     String    // the harness commented on, or the one forked
  harnessTitle  String
  actorName     String
  targetId      String    // the comment, or the fork
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  @@index([autonomousEnv, userId, createdAt])
  @@index([autonomousEnv, userId, readAt])
  @@map("community_notifications")
}

model CommunityFollow {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  autonomousEnv String   @default("prod")
  authorId      String
  userId        String
  createdAt     DateTime @default(now())

  @@unique([autonomousEnv, authorId, userId])
  @@index([autonomousEnv, userId])
  @@map("community_follows")
}

/// A thin MIRROR of a product user. Identity is the normalized email authenticated by Autonomous
/// SSO. The two Autonomous account planes issue different subjects for the same email, so production
/// and staging subjects are stored separately. Lives in the SAME MongoDB the agent-manager uses, but
/// in its own `users` collection — the manager never touches it.
///
/// The production subject (`externalId`) remains unique because SDS stores that value as a device's
/// `customer_id`. A device may connect before its owner has signed in, so that provisional row uses a
/// deterministic non-deliverable email until the first production SSO login claims it.
model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique // normalized SSO identity; provisional device rows use @pending.harness.invalid
  externalId      String    @unique // production SSO subject == SDS `customer_id`; local-prod-* until known
  stagExternalId  String? // staging SSO subject; authentication still keys by email
  passwordHash    String? // legacy only; SSO users have none
  name            String?
  role            String    @default("user") // user | admin
  // Which Autonomous account plane this user signs in against. Existing rows are backfilled to
  // staging because they were created while the app used staging globally; new users default prod.
  autonomousEnv   String    @default("prod") // prod | stag
  // The user's private harness grid, minted on first ask and never rewritten (see routes/grid.ts).
  // Deliberately NOT @unique: on MongoDB a unique index counts nulls as values, so every user
  // without a grid would collide with every other. Global uniqueness is the grid control plane's
  // rule to enforce; ours is only one name per user, which the conditional write in the route gives.
  gridName        String?
  // Cloudflare `CF-IPCountry` (ISO-2) of the last control-plane request this user made, stamped by
  // middlewares/authMiddleware.ts through lib/clientGeo.ts (rate-floored, never per request). The
  // REST call always comes from the person's own computer, so this is the "where is the user" answer;
  // `Machine.countryCode` and the machine/device presence rows carry the CONNECTING SOCKET's country
  // instead, which for a remote machine is the VPS, not the person.
  // Null on rows that predate it or when the request did not come through Cloudflare.
  lastCountryCode String?
  lastCountryAt   DateTime?
  // The `utm_*` and `rid` a sign-in arrived with (lib/signInAttribution.ts), recorded by /api/auth/exchange.
  // `signUpAttribution` is the tags the account was created with — how it was acquired — written once,
  // by the sign-in that created the row (or claimed a device's provisional row). Unset for an account
  // created untagged or elsewhere, so a later tagged sign-in never claims the acquisition.
  // `lastAttribution` is the latest tagged sign-in.
  signUpAttribution SignInAttribution?
  lastAttribution   SignInAttribution?
  // The account's Google subject as this backend last read it LIVE from the Autonomous profile
  // (lib/googleSubject.ts, ADR 0046), so `GET /api/grid/profile` can answer for a computer signed in
  // by QR, whose token Autonomous cannot read. `googleSubCheckedAt` unset means never checked — and on
  // MongoDB that is ABSENT on every row written before today as well as null, so a filter on
  // `googleSubCheckedAt: null` alone misses the legacy rows (the trap `Machine.deletedAt` and
  // routes/grid.ts document); `UserService.recordGoogleSubject` adds `isSet: false`. Once checked, a
  // null `googleSub` means "this account has no Google identity".
  // Both are internal: `UserService.toPublic` leaves them out of every user-describing response.
  googleSub          String?
  googleSubCheckedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stagExternalId])
  @@map("users")
}

type SignInAttribution {
  source     String?
  medium     String?
  campaign   String?
  term       String?
  content    String?
  rid        String? // Autonomous referral id
  recordedAt DateTime
}

/// A machine: the unit that groups N agents and the thing a user creates, names, pays for and
/// attaches a device to. Maps a user to their provisioned machine (agent-node) + the per-machine
/// api-key the backend generated for it. The backend injects this key when reverse-proxying the
/// user's data-plane traffic to the manager (the web never sees it). One node per machine.
/// The manager owns the authoritative `machine_nodes` record; this is the backend's routing view
/// (api-key + which manager owns the node).
model Machine {
  id                              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                          String // owner (User.id); a user may own many machines
  machineId                       String    @unique // sha256(apiKey)[:32] — the routing key, on the wire as `machineId`
  apiKey                          String // per-machine key; the data-plane credential (handed to the owner) + routing/node auth
  managerId                       String // which manager owns the node → its dial-in socket routes this machine's traffic
  workspaceId                     String?
  // Immutable upstream plane copied from the owner when the machine is created. Billing and campaign
  // credentials always resolve from this value, even if an admin later switches the user env.
  autonomousEnv                   String    @default("prod") // prod | stag
  // Subscription plan the machine is on (SubscriptionPlan.id). cpus/memory are resolved THROUGH the
  // plan (the manager reads it), replacing the old per-machine cpus/memory fields. Optional so legacy
  // rows read; set to the default plan on every new create.
  planId                          String?
  // Denormalized from SubscriptionPlan.authMode at creation — IMMUTABLE (set once; there is no
  // plan-switch path). All authMode logic reads THIS field, never the plan (a later plan-doc edit
  // must not flip a live machine's mode). Optional so legacy rows read; backfilled at backend startup.
  authMode                        String?
  // The machine's display name. User-editable (PATCH /api/machines/:id); seeded ONCE from the
  // connecting computer's hostname when still empty, then never overwritten by a connect.
  name                            String?
  // Hostname of the COMPUTER on its LAST adapter-ws connect (remote machines only) — the adapter
  // sends it as `?label=` and it is overwritten every time, so it reflects the most recent computer.
  // Secondary detail only: never used as the machine's name. Null for machines that never connected.
  hostname                        String?
  // The COMPUTER currently bound to this machine — the CLI's per-computer id, normalized
  // (lib/deviceAuth.ts:normalizeComputerId). Stamped when a computer is connected through the
  // device-auth grant and refreshed on every adapter-ws connect, so `harness auth device` on the same
  // box reconnects to THAT machine instead of minting a second one. Null on rows that predate it.
  computerId                      String?
  // How the computer signed in on its LAST adapter-ws connect: `team` for a team session (lib/teamSession.ts),
  // a Mac's team account running teammates' Swarm agents; `computer` for any other sign-in. A `team` row taken
  // over by a normal sign-in is set to `computer` before that socket attaches, so `team` never names a machine a
  // normal sign-in serves. Null on rows that predate it (never a team machine). A team session acts only for a
  // row marked `team`; Swarm routing reads it (Task 3 of docs/plans/2026-10-24-swarm-team-account.md).
  sessionKind                     String?
  // A team machine's Mac: the machineId of the owner's own machine on the computer whose Harness Team account this
  // is, so every list shows that Mac once ("One machine" in docs/plans/2026-10-24-swarm-team-account.md). Copied from
  // the team session (`HarnessSession.hostMachineId`) whenever that session registers its machine; nothing a team
  // session sends sets it. Null for every other machine, a dedicated one (`harness team on`) included.
  hostMachineId                   String?
  // Version string the CLIENT reported on its LAST adapter-ws connect (remote machines only) — the
  // client sends it as `?v=` and it is overwritten every time, so it reflects the most recent connect.
  // Self-declared and sanitized at the upgrade; null for a machine that never connected or a client
  // old enough not to send it.
  clientVersion                   String?
  // Cloudflare `CF-IPCountry` (ISO-2) of the computer on its LAST adapter-ws connect — same
  // overwrite-every-connect rule as `hostname`/`clientVersion`. Null when the upgrade did not come
  // through Cloudflare (local dev) or the row predates the field.
  countryCode                     String?
  // Billing lifecycle for newly-created campaign machines. Missing on old rows means legacy-active.
  // Grandfathered Remote machines are `not_required`; new paid Remote and managed machines move pending -> active only after
  // checkout verification. A cancelled paid subscription stays active until its period end, then
  // the billing worker moves it to `suspended` and the manager stops (but preserves) its node.
  billingStatus                   String?
  externalDeviceId                String?
  externalSubscriptionId          String?
  externalSubscriptionStatus      Int?
  externalSubscriptionEndAt       DateTime?
  externalSubscriptionCancelledAt DateTime?
  billingActivatedAt              DateTime?
  billingError                    String?
  billingErrorAt                  DateTime?
  // AES-256-GCM envelope containing the managed campaign llm_api_key. Always null for Remote.
  llmApiKeyEncrypted              String?
  // authMode 'provider' only. The A2A endpoint this machine is backed by — supplied by the OWNER, so
  // every outbound request to it goes through lib/providerUrl.ts (SSRF guard), never a bare fetch.
  providerUrl                     String?
  // AES-256-GCM envelope (lib/machineCredential.ts) holding the owner's credential FOR THE PROVIDER.
  // Write-only from the client's point of view: never returned by an API, never logged.
  providerCredentialEncrypted     String?
  // Soft-delete marker: destroy() stamps this instead of removing the row (the container/node is
  // still torn down). Every read path treats a stamped row as absent. NOTE (Prisma-Mongo): legacy
  // rows LACK the field entirely and `{deletedAt: null}` does not match absent — filter with the
  // shared `machineAlive` helper (lib/prisma.ts), never an inline `deletedAt: null`.
  deletedAt                       DateTime?
  createdAt                       DateTime  @default(now())

  @@index([userId])
  @@index([userId, computerId])
  @@index([managerId, billingStatus])
  @@index([billingStatus, externalSubscriptionStatus, externalSubscriptionEndAt])
  @@map("machines")
}

/// Durable, account-scoped right to use the Free campaign tier. `reserved` prevents two tabs from
/// starting two Free machines; once activation succeeds it becomes `claimed` and is never deleted,
/// even if the machine is later upgraded or removed.
model MachineFreeEntitlement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  autonomousEnv String    @default("prod") // copied from the machine; one lifetime Free grant per env
  machineId     String    @unique
  status        String    @default("reserved") // reserved | claimed
  reservedAt    DateTime  @default(now())
  claimedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([userId, autonomousEnv])
  @@map("machine_free_entitlements")
}

/// Subscription package: the per-machine resource tier + price. A machine is assigned a plan at
/// create (the default one); the manager reads cpus/memory THROUGH the machine's plan. The backend
/// owns writes; the manager mirrors this read-only. Exactly one plan should have isDefault=true.
model SubscriptionPlan {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  autonomousEnv          String    @default("prod") // prod | stag; external ids differ between planes
  cpus                   String // docker --cpus, e.g. "1"
  memory                 String // docker --memory, e.g. "2g"
  maxAgents              Int       @default(1) // cap enforced by the backend on agent create
  priceUsd               Float     @default(0)
  // Backend-owned daily voice/STT allowance in seconds. `0` means unlimited; null keeps legacy
  // plans unlimited until the worker backfills their explicit value.
  dailyVoiceLimitSeconds Int?
  // How the agent-node authenticates with Claude:
  //  "self"    → the user logs the in-container `claude` CLI in (creds in ~/.claude), no env injected.
  //  "managed" → the manager injects ANTHROPIC_* creds into the container at start (no user login).
  authMode               String    @default("self")
  isDefault              Boolean   @default(false)
  // Catalog visibility is explicit so legacy Self-Auth/Managed rows remain readable but cannot be
  // selected for new machines. Missing means unavailable. Free/Pro/Max/Remote are synchronized from
  // the environment-specific Autonomous campaign catalog when billing is enabled.
  available              Boolean?
  externalPlanId         Int?
  externalPlanName       String?
  campaignCode           String?
  // Origin that supplied externalPlanId (staging/prod ids are not interchangeable). A cached
  // catalog is reusable only when this matches the current AUTONOMOUS_BFF_URL origin.
  catalogSource          String?
  externalMetadata       Json?
  catalogSyncedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([autonomousEnv, name])
  @@index([autonomousEnv, externalPlanId])
  @@map("subscription_plans")
}

/// One UTC-day usage bucket per machine. `usedMs` includes pending STT reservations so concurrent
/// devices cannot both pass the same remaining allowance.
model MachineVoiceDailyUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId String
  dayKey    String
  usedMs    Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([machineId, dayKey])
  @@index([expiresAt])
  @@map("machine_voice_daily_usage")
}

/// Idempotency + crash-recovery record for a completed voice upload. A reservation is created in
/// the same transaction that increments MachineVoiceDailyUsage, committed after STT returns, and
/// released by the worker if STT fails or the process disappears.
model MachineVoiceReservation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  uploadId    String    @unique
  machineId   String
  dayKey      String
  durationMs  Int
  status      String    @default("pending") // pending | committed | released
  releaseAt   DateTime?
  expiresAt   DateTime
  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, releaseAt])
  @@index([expiresAt])
  @@index([machineId, dayKey])
  @@map("machine_voice_reservations")
}

/// Audit/idempotency record for every hosted checkout attempt. Redirect URLs can contain opaque
/// provider state, so they are owner-only and never logged. Multiple attempts may exist per machine.
model MachineCheckoutAttempt {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  machineId         String
  userId            String
  // Snapshot of the machine's immutable upstream plane. Callback completion must not depend on the
  // user's current env because an admin may switch it while Stripe is open.
  autonomousEnv     String    @default("prod")
  externalPlanId    Int
  externalDeviceId  String
  sessionId         String    @unique
  // Stable local operation id embedded in success/failure callback URLs. Hosted checkout operations
  // use this instead of relying on the provider returning a checkout-session id, including Free card setup.
  operationId       String?
  operationType     String? // subscribe | plan_change
  sourcePlanId      String?
  targetPlanId      String?
  providerSessionId String?
  redirectUrl       String?
  // Snapshot of the non-secret checkout request so checkout-complete can resend the exact same
  // fields even if the user's email, WEB_URL, or callback config changes while Stripe is open.
  checkoutEmail     String?
  successUrl        String?
  failureUrl        String?
  webOrigin         String?
  status            String    @default("pending") // pending|completed|failed|cancelled
  error             String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([machineId, createdAt])
  @@index([userId])
  // MongoDB unique indexes treat repeated null optional fields as duplicates. sessionId is already
  // unique and equals operationId for every new attempt; keep this nullable legacy field indexed.
  @@index([operationId])
  @@map("machine_checkout_attempts")
}

/// Per-machine agent association (an "agent" = one working unit with its own workspace and engine),
/// populated by the data-plane tap (lib/agentTracker.ts): when a create succeeds we upsert one row;
/// on DELETE we remove it. Lets the backend answer "how many agents does this machine have" without
/// owning contents (the agent-node's SQLite remains the source of truth).
model MachineAgent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId String // owning machine (matches Machine.machineId)
  agentId   String // the agent unit's UUID, from the create response
  name      String?
  createdAt DateTime @default(now())

  @@unique([machineId, agentId])
  @@index([machineId])
  @@map("machine_agents")
}

/// A device: one COMPUTER running the `harness` daemon, which serves a dial over USB and drives the
/// owner's machines on its behalf. There is no pairing code and no device token — `/api/device-ws`
/// authenticates with the owner's SSO access token plus a `?computer=` id, and this row is
/// resolved-or-created from that. Deleting a row therefore FORGETS a dial (and closes its live socket);
/// it is not a revocation, because the daemon re-creates it on its next connect.
model DeviceBinding {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String // owner (User.id)
  // The COMPUTER this device row belongs to — the `harness` CLI's per-computer id, normalized
  // (lib/deviceAuth.ts:normalizeComputerId). This is the ONLY way a device comes into existence now:
  // `/api/device-ws` authenticates with the owner's SSO token plus `?computer=`, and the row is
  // resolved-or-created from it. Optional only so `prisma db push` reads rows that predate it — those
  // are pruned at boot (pruneLegacyDeviceBindings), since nothing can ever connect as them again.
  computerId String?
  // LEGACY per-machine pairing pinned the device here. NULL for per-user devices — they pick machines at
  // runtime over the commander socket (`machine_select`). Kept only to read a legacy device's origin.
  machineId  String? // (Machine.machineId)
  // Derived, never random: "cmp-" + sha256(userId:autonomousEnv:computerId)[:24]. See
  // DeviceService.resolveOrCreateForComputer for why each ingredient is load-bearing.
  deviceId   String    @unique
  name       String    @default("device")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  // ── Reported by the device, snapshotted at each `device_hello` (deviceWs handleHello) ──────────
  // These exist so the mobile app can render a device WITHOUT a live socket of its own; the web reads
  // the same facts off the wire instead. All nullable: a device that has never connected on a build
  // that reports them has none of them, and that must read as "unknown", never as a zero value.
  firmwareVersion String?
  chip            String?
  // WiFi as of the last hello. No shipping client reports these since the dial went cable-only, so they
  // stay null — which clients must render as "no data" rather than an empty name or a zero-bar meter.
  ssid            String?
  rssi            Int? // dBm, negative. 0 is never stored — the firmware uses it for "unknown".
  // The machine this device is CURRENTLY attached to (`machine_select` → relay setActiveMachine).
  // Deliberately NOT the legacy `machineId` above: that one is the immutable pairing origin, this one
  // moves every time the user picks a different machine on the device screen. Null while the device is
  // parked on the picker. NOT cleared on socket close — a fast reconnect would race its own teardown —
  // so on an offline device this reads as "last attached to"; clients gate it on liveness.
  activeMachineId String?

  @@index([userId])
  @@index([userId, computerId])
  @@map("device_bindings")
}

/// READ-ONLY view of the agent-manager's `managers` collection (the manager owns writes).
/// The backend reads capacity (maxNodes/nodeCount) to pick a manager on create, and apiKey to
/// authenticate its dial-in socket (/api/manager-ws). No address is needed — the manager dials the
/// backend (inverted transport). The `@unique` on managerId matches the manager's own index so
/// `prisma db push` from both services stays consistent.
model Manager {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  managerId   String    @unique
  maxNodes    Int       @default(0)
  nodeCount   Int       @default(0)
  apiKey      String? // this manager's MANAGER_API_KEY (x-api-key on its dial-in socket)
  agentEngine String? // manager AGENT_ENGINE default for machine_nodes without an explicit engine
  lastSeenAt  DateTime?

  @@map("managers")
}

/// Backend-owned routing record for a published app (mirrors Machine's role for machines):
/// answers "which manager owns this subdomain" for the :8087 public app-proxy. The manager owns
/// the parallel `app_deployments` record (subdomain → appPort). Written at register; the subdomain
/// is a random slug (user never picks it). machineId/agentId denormalized for filtered list/get.
model Subdomain {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  subdomain String   @unique
  machineId String // owning machine (Machine.machineId — the data path routes by it)
  agentId   String // the agent unit
  managerId String // which manager serves it (app control RPC target)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([machineId])
  @@index([machineId, agentId])
  @@map("subdomains")
}

/// Account control only; no report times, usage counters or machine inventory.
model ProductUsagePreference {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String  @unique
  enabled  Boolean
  revision Int     @default(1)

  @@map("product_usage_preferences")
}

/// Only fleet-wide counters. Never add an account, machine, agent, location or event timestamp.
model ProductUsageTotal {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  dayUtc DateTime
  metric String
  value  Int

  @@unique([dayUtc, metric])
  @@map("product_usage_totals")
}

/// Random report receipt, used only to prevent retries counting twice. No identity or report body.
model ProductUsageReceipt {
  id        String   @id @map("_id")
  expiresAt DateTime

  @@map("product_usage_receipts")
}

/// One UTC day a person used Harness while sharing product usage, under a keyed pseudonym
/// (HMAC of the user id; never the id itself). Expires 10 days after the day; the hourly rollup
/// keeps only anonymous `people_*` totals. Deleted at once when the person turns sharing off.
model ProductUsageActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  subject   String
  dayUtc    DateTime
  surfaces  String[]
  worked    Boolean  @default(false)
  signupDay DateTime
  staff     Boolean
  expiresAt DateTime

  @@unique([subject, dayUtc])
  @@map("product_usage_activity")
}

/// Legacy individual counters. New ingestion is disabled; dayUtc TTL removes these after 35 days.
model AnalyticsDailyBucket {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String
  machineId        String
  dayUtc           DateTime // midnight UTC of the day these counters belong to
  engine           String
  mode             String // self | managed | remote | provider
  origin           String // human | scheduled | system | api
  schemaVersion    Int
  // Client monotonic stamp, CLAMPED server-side against receivedAt. Ordering key for last-write-wins:
  // each (machine, day, engine, mode, origin) has exactly ONE writer, so no version vector is needed.
  // A client-chosen revision was rejected — a bad or hostile value could pin a record permanently.
  generatedAt      DateTime
  instructions     Int      @default(0)
  turnsStarted     Int      @default(0)
  turnsCompleted   Int      @default(0)
  turnsFailed      Int      @default(0)
  turnsCancelled   Int      @default(0)
  turnsInputNeeded Int      @default(0)
  agentRuntimeMs   BigInt   @default(0) // sum of terminal turn durations; overlaps counted twice by design
  updatedAt        DateTime @updatedAt

  @@unique([userId, machineId, dayUtc, engine, mode, origin, schemaVersion])
  @@index([userId, dayUtc])
  @@map("analytics_daily_buckets")
}

/// Legacy, no longer written. Retained only until the 35-day dayUtc expiry.
/// Harness Analytics — NON-ADDITIVE metrics plus the reporting heartbeat. Exactly one row per
/// machine per day. A row with all-zero counters means "the machine was up and idle"; a MISSING row
/// means "we have no data". The UI must never render those two states the same way.
model AnalyticsDailyMachine {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  machineId         String
  dayUtc            DateTime
  wallClockActiveMs BigInt   @default(0) // union of turn intervals, computed locally where all are visible
  activeAgents      Int      @default(0) // distinct agents; sums across machines (an agent has one machine)
  uptimeMs          BigInt   @default(0) // denominator for utilization; 0 when not meaningful (provider)
  reported          Boolean  @default(true) // heartbeat: this machine DID report this day
  generatedAt       DateTime
  updatedAt         DateTime @updatedAt

  @@unique([userId, machineId, dayUtc])
  @@index([userId, dayUtc])
  @@map("analytics_daily_machines")
}

/// Harness Analytics — per-machine collector control and coverage state. Backs the Coverage panel
/// and the ingest response, which is the ONLY channel a headless collector has for learning that the
/// account turned collection off or deleted its history.
model AnalyticsMachineState {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  machineId        String    @unique
  userId           String
  // Collection is ON by default; the owner can switch it off per machine or for the whole account.
  consent          String    @default("on") // on | off
  // Bumped by a user-triggered deletion. Uploads carrying an older epoch are refused, so a collector
  // still holding queued records cannot resurrect erased history.
  epoch            Int       @default(0)
  collectorVersion String?
  engineCoverage   String[] // engines this collector instruments
  // Engines the collector can SEE here (registered agents / discovered binaries). The difference
  // enginesPresent - engineCoverage is what the UI shows as "not instrumented" — coverage alone
  // cannot tell an uninstrumented engine from one that is simply not installed.
  enginesPresent   String[]
  lastReportAt     DateTime?
  clockSkewMs      Int? // receivedAt - generatedAt at the last report; surfaced in Coverage
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@map("analytics_machine_states")
}

/// Legacy presence histories: new writes are disabled and dayUtc expires after 35 days.
/// The comments below document old records for historical readers, not current collection.

/// Per-day record of whether a user had the desktop app open, and on which machine. One row per
/// (user, machine, UTC day): "user online that day" is therefore a DISTINCT count of `userId`, while
/// `connections` still sums. The source is the local `harness` daemon reporting its own loopback
/// clients over adapter-ws (`app_presence`, src/lib/adapterWs.ts) — NOT the web-ws upgrade, which
/// the app never performs itself (only the daemon does, per foreign machine it relays) and which
/// therefore missed every single-machine user. `connections` = times a window attached to that
/// daemon that day; a session spanning midnight produces a row for each day it touches with
/// `connections: 0`.
/// Deliberately NO `countryCode` here, unlike the device/machine rows: the signal arrives over the
/// DAEMON's socket, so the country would be the daemon's (a VPS for a remote machine), not the
/// person's. "Where is the user" is `User.lastCountryCode`, stamped from their own REST calls; the
/// machine's own country sits on `machine_daily_presence`, joinable through `machineId`.
model UserDailyPresence {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  // Machine.machineId whose daemon reported the window (the adapter-ws socket the `app_presence`
  // frame came over). Null ONLY on rows that predate the field — those were one per (user, day).
  // Optional rather than required for that reason: Prisma-Mongo refuses to READ a row missing a
  // required field. The old `(userId, dayUtc)` unique index is dropped at worker boot
  // (lib/db/migrate.ts migrateUserPresencePerMachine); the legacy rows stay distinct under the new
  // key because they were already distinct on (userId, dayUtc).
  machineId   String?
  dayUtc      DateTime
  connections Int      @default(0)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, machineId, dayUtc])
  @@index([userId, dayUtc])
  @@map("user_daily_presence")
}

/// Per-day record of a user on a surface other than the desktop app — `UserDailyPresence` stays the
/// desktop app's alone. One row per (user, surface, UTC day); DAU is a distinct `userId`.
/// `surface`: 'tui' (`harness tui`, reported by the local daemon like a desktop window: adapter-ws
/// `app_presence { surface: 'tui' }`, src/lib/adapterWs.ts) — 'harness-os' / 'harness-os-pi' when that
/// TUI is Harness OS on a PC / on an Orange Pi (cli lib/windowSurfaces.ts) —, 'mobile' / 'web' (the app's and the
/// browser's own web-ws sockets, declared with `?client=` — src/lib/webWs.ts; the daemon's relay
/// socket declares nothing and is never counted). `connections` = sessions opened that day (for
/// mobile/web one per machine socket); a session spanning midnight gives the next day `0`.
/// No `machineId`: mobile and web hold a socket per machine they look at, and it is one person.
model UserDailyClientPresence {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  surface     String
  dayUtc      DateTime
  connections Int      @default(0)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, surface, dayUtc])
  @@index([surface, dayUtc])
  @@map("user_daily_client_presence")
}

/// Per-day record of whether a user actually established a remote p2p connection to stream a
/// terminal (signaled by a p2p_offer frame passing through the web-ws relay), scoped to the machine.
model UserDailyRemoteUsage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  machineId   String
  dayUtc      DateTime
  sessions    Int      @default(0)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, machineId, dayUtc])
  @@index([userId, dayUtc])
  @@map("user_daily_remote_usage")
}

/// Per-day record of whether a user's device was connected to the device-ws relay
/// (src/lib/deviceWs.ts). One row per (user, device, UTC day); a connection spanning midnight
/// produces a row for each day it touches, the later ones with `connections: 0`.
/// `lastSeenAt` is refreshed on connect, on close, and at most every DEVICE_PRESENCE_WRITE_MS while
/// the socket is open, so it lags real liveness by <= that interval — the same rule as
/// MachineDailyPresence. (Before 2026-09-23 it only moved on a RECONNECT, so a device that stayed
/// connected read as last-seen-at-midnight all day; rows older than that cannot be used to measure
/// how long a device was up.) Redis `device:{id}` remains the "online right now" answer.
model UserDailyDevicePresence {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  deviceId    String
  dayUtc      DateTime
  connections Int      @default(0)
  countryCode String? // Cloudflare `CF-IPCountry` (ISO-2) at the LAST write that carried one; null = unknown / pre-feature row
  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, deviceId, dayUtc])
  @@index([userId, dayUtc])
  @@map("user_daily_device_presence")
}

/// Per-day record of whether a MACHINE's `harness` daemon was connected to the adapter-ws relay
/// (src/lib/adapterWs.ts). One row per (machine, UTC day); a connection spanning midnight produces a
/// row for each day it touches. `lastSeenAt` is refreshed on connect, on close, and at most every
/// MACHINE_PRESENCE_WRITE_MS while the socket is open, so it lags real liveness by ≤ that interval.
/// Redis `machine:{id}:mgr` remains the "online right now" answer; this is the history.
/// `turnsStarted` is the usage signal on top of liveness: every `turn_started` up-frame the daemon
/// relays bumps it (adapterWs hub tap). A row can legitimately read `connections: 0, turnsStarted: 0`
/// — a session that spanned midnight and sat idle.
model MachineDailyPresence {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId    String // Machine.machineId
  userId       String // owner at connect time (Machine.userId), for per-user rollups
  dayUtc       DateTime
  connections  Int      @default(0)
  turnsStarted Int      @default(0) // `turn_started` up-frames the daemon sent that day (adapterWs tap)
  countryCode  String? // Cloudflare `CF-IPCountry` (ISO-2) at the LAST write that carried one; null = unknown / pre-feature row
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([machineId, dayUtc])
  @@index([userId, dayUtc])
  @@map("machine_daily_presence")
}

/// Per-day record of an AGENT being driven: one row per (machine, agent, UTC day), created and
/// bumped by every `turn_started` the machine's daemon relays through adapter-ws
/// (src/lib/adapterWs.ts). There is no "connect" for an agent — a turn is the presence signal —
/// so unlike the machine/user/device rows there is no `connections` column. `agentId` is the
/// plaintext correlation id on the frame; the turn's content stays E2EE and is never read here.
model AgentDailyPresence {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId    String // Machine.machineId — agentId is only unique within a machine
  agentId      String // MachineAgent.agentId (may be gone from machine_agents later — keep the history)
  userId       String // owner at the time of the turn
  dayUtc       DateTime
  turnsStarted Int      @default(0)
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([machineId, agentId, dayUtc])
  @@index([machineId, dayUtc])
  @@index([userId, dayUtc])
  @@map("agent_daily_presence")
}

/// One person's review of one harness in the Harness Store — a star rating and, optionally, a title
/// and some words. One row per (harness, user): writing again replaces it, so a rating cannot be
/// stacked. `harnessId` is the registry id (`owner/name`), never validated against the registry here
/// — the registry lives in the CLI, and a review of a harness the backend has not heard of is still a
/// review. `authorName` is a snapshot of the user's name at write time; the store shows it, never
/// the email.
model HarnessReview {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  harnessId  String
  userId     String // User.id
  authorName String
  rating     Int // 1..5
  title      String?
  body       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([harnessId, userId])
  @@index([harnessId])
  @@map("harness_reviews")
}

/// Discovery metadata for one account-bound, view-only invitation. Content remains on the owner
/// daemon, which independently authorizes every observer against its durable local grant list.
model HarnessShare {
  /// A session view derived from this Super Tab; membership is rechecked at admission.
  superTabId     String?
  id             String    @id @map("_id")
  ownerId        String
  machineId      String
  agentId        String
  recipientEmail String
  autonomousEnv  String
  name           String
  engine         String?
  ownerPublicKey String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([machineId, agentId, recipientEmail])
  @@index([recipientEmail, autonomousEnv, expiresAt])
  @@index([ownerId, machineId])
  @@map("harness_shares")
}

/// A whole machine its owner shares with other accounts (docs/plans/2026-10-15-share-machine-plan.md):
/// with these addresses, and with everyone at `domain` when the owner turned that on. Off by default, so
/// a machine with no row is shared with no one. The backend's copy decides who is LISTED the machine and
/// who may select it on the relay; the machine's own daemon keeps the policy it published and trusts
/// only the keys of accounts that policy names (cli services/sharedMachines.ts), as Share's owner does.
model MachineShare {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId     String   @unique
  ownerId       String
  autonomousEnv String
  /// Normalized (trimmed, lower case), never the owner's own.
  emails        String[]
  /// The owner's email domain while "Everyone at @domain" is on; null when off. Written by the backend
  /// from the owner's verified address, never taken from the client, and never a public domain.
  domain        String?
  /// Stable while an email/domain grant continues; a removed and restored grant
  /// gets a new version so old Super Tab contributions cannot resume silently.
  grantVersions Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([emails, autonomousEnv])
  @@index([domain, autonomousEnv])
  @@index([ownerId])
  @@map("machine_shares")
}

/// Someone at a machine's domain added it to their machines (a domain share takes one click to add; an
/// address the owner named needs none). Only the accounts that added it are trusted by the machine.
model MachineShareAdd {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  machineId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([machineId, userId])
  @@index([userId])
  @@map("machine_share_adds")
}

/// The account's DESK: its tabs, in order, and the agents each holds — one document per user, the
/// same on every computer the person signs in on (owner, 2026-09-21: "tab là global"). Holds only
/// what the person would call "my tabs": ids, names, order, `(machineId, agentId)` pairs. Nothing
/// about a window — focus, zoom, pane sizes, which tab is on screen — those differ per computer and
/// stay in each app's own state file. Written through `POST /api/desk/ops` (routes/desk.ts): small
/// idempotent operations applied in order under `revision`, so two windows racing merge by rule
/// rather than by whoever saved last. Plaintext, like `Machine.name` and `MachineAgent.name`: the
/// doc adds no class of data the backend does not already hold.
model Desk {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  revision  Int      @default(0)
  tabs      Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("desks")
}

/// The account's connected services (Linear, GitHub…), sealed by a daemon for every machine of the account
/// (cli/src/lib/e2ee/connectorVault.ts): only those machines can open it. The backend keeps the latest
/// envelope and a revision for compare-and-set, and tells every computer when it changed.
model ConnectorVault {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  revision  Int      @default(0)
  envelope  Json
  updatedAt DateTime @updatedAt

  @@map("connector_vaults")
}

/// Agent Messages, per tab (docs/design/2026-10-10-agent-messages.md): whether the harnesses in one desk tab
/// may message each other. Absence means off. Kept beside the desk, never in its tab JSON: a backend pod that
/// has not upgraded drops a tab whose JSON it does not know (lib/desk.ts parseTabs). A deterministic _id makes
/// a concurrent first write converge.
model AgentMessageTab {
  id        String   @id @map("_id") @db.ObjectId
  userId    String
  tabId     String
  enabled   Boolean  @default(false)
  /// The tab's leader: a pane of the tab on one of the owner's machines. Written as explicit nulls at create.
  leaderMachineId String?
  leaderAgentId   String?
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("agent_message_tabs")
}

/// A tab its owner shared with other accounts (docs/superpowers/specs/2026-10-15-agent-messages-across-accounts-design.md).
/// `roster` is the owner's signed blob, stored and never read: members verify it against the owner's key.
model AgentMessageShare {
  id             String    @id @map("_id") // sharedTabId: sha256(['amsg-share', ownerUserId, tabId])[:24]
  ownerUserId    String
  ownerMachineId String
  tabId          String
  autonomousEnv  String
  rosterVersion  Int       @default(0)
  roster         Json?
  stoppedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerUserId, tabId])
  @@map("agent_message_shares")
}

model AgentMessageInvite {
  id             String    @id @map("_id")
  shareId        String
  ownerUserId    String
  ownerMachineId String
  email          String
  autonomousEnv  String
  expiresAt      DateTime
  acceptedBy     String?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([shareId, email])
  @@index([email, autonomousEnv, expiresAt])
  @@map("agent_message_invites")
}

model AgentMessageMember {
  id         String    @id @map("_id") // sha256(['amsg-member', shareId, userId])[:24]
  shareId    String
  userId     String
  email      String
  inviteId   String
  acceptedAt DateTime  @default(now())
  removedAt  DateTime?

  @@index([userId])
  @@index([shareId])
  @@map("agent_message_members")
}

/// Explicit account opt-ins; missing choices stay off. Each write changes one feature.
// Super Tabs own their roster and history independently of desktop pane layout. Revision writes
// serialize membership changes, commands and delivery claims inside Mongo transactions.
model SuperTab {
  id             String   @id @map("_id")
  ownerId        String
  autonomousEnv  String
  memberIds      String[]
  invitedEmails  String[]
  machineIds     String[]
  /// Machines whose host still has to clean up after their removal: read apart from the 100-Swarm host poll.
  cleanupMachineIds String[] @default([])
  revision       Int      @default(0)
  state          Json
  /// 1: the whole Swarm in `state`. 2: split into the Swarm* part collections (docs/design/2026-10-26-swarm-state-parts.md);
  /// `state` is then `{ version: 2 }`, which every older backend refuses before writing, and the old state is kept in `legacyState`.
  format         Int      @default(1)
  migratedAt     DateTime?
  legacyState    Json?
  /// The Workspace (SwarmWorkspace) it belongs to, also on its head part. Null only on a Swarm from before Workspaces, until migrated.
  workspaceId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([autonomousEnv, workspaceId])
  @@index([autonomousEnv, memberIds])
  @@index([autonomousEnv, invitedEmails])
  @@index([autonomousEnv, machineIds])
  @@index([autonomousEnv, cleanupMachineIds])
}

// A terminal retains its history when removed from a roster. These bindings
// prevent contributing a private session to another project's audience later.
model SuperTabSessionScope {
  /// Administrative retirement belongs only to the Swarm that withdrew this session.
  releasedTabIds String[] @default([])
  /// A bounded native close may finish after membership is withdrawn.
  closeLeaseId String?
  closeLeaseUntil DateTime?
  closeLeaseGeneration String?
  /// Serializes contribution changes with stop intent across public Swarms.
  stopReleaseId String?
  /// Set when the session first became confidential (a Lead or in a private conversation): the write a concurrent
  /// registration in another Swarm conflicts with, so a confidential session keeps one registration (final review C1).
  confidential Boolean?
  id           String   @id @map("_id")
  scopeIds     String[]
  privateScope String?

  @@index([scopeIds])
}

model SuperTabMessage {
  id              String   @id @map("_id")
  tabId           String
  conversationId  String
  sequence        Int
  author          Json
  source          Json?
  text            String
  /// Files posted with the message (superTabs/attachments.ts); the bytes live in the attachments bucket.
  attachments     Json?
  replyTo         String?
  recipientIds    String[]
  /// People a Lead tagged (superTabs/mentions.ts); absent on older rows.
  mentions        String[]
  createdAt       DateTime @default(now())

  /// Pages read by (sequence, id): older rows of one command share a sequence.
  @@index([tabId, conversationId, sequence, id])
}

/// A Lead's tag of a person, waiting until they reply in that conversation or mark it done (superTabs/mentions.ts).
/// Kept out of the tab state so an older backend still reads it; removed 30 days after createdAt by a TTL index.
model SuperTabMention {
  id             String    @id @map("_id")
  tabId          String
  personId       String
  projectId      String
  conversationId String
  messageId      String
  authorAgentId  String
  createdAt      DateTime
  resolvedAt     DateTime?
  /// reply | done
  resolvedBy     String?

  @@index([tabId, personId, createdAt])
  @@index([tabId, conversationId, personId])
}

/// One reactor's emoji on one message (superTabs/reactions.ts). The id is derived from all four, so adding the same
/// reaction twice keeps one row; message pages count them.
model SuperTabReaction {
  id             String   @id @map("_id")
  tabId          String
  conversationId String
  messageId      String
  /// person | agent
  actorKind      String
  actorId        String
  emoji          String
  createdAt      DateTime @default(now())

  @@index([tabId, messageId])
}

/// A question to one person, with options and a recommendation (backend/src/superTabs/decisions.ts). Kept out of the tab
/// state, as mentions are: an asking agent and the asked person read it, and the person answers it once.
model SuperTabDecision {
  id             String    @id @map("_id")
  tabId          String
  /// The ask that put several questions to one person together.
  batchId        String
  projectId      String
  conversationId String
  /// The task whose needs_human asked it, or null for the Lead's decision.ask.
  assignmentId   String?
  personId       String
  askerAgentId   String
  question       String
  options        String[]
  recommended    Int
  unblocks       String
  createdAt      DateTime
  answeredAt     DateTime?
  choice         Int?
  note           String?

  @@index([tabId, personId, createdAt])
  @@index([tabId, askerAgentId, createdAt])
  @@index([tabId, projectId, createdAt])
}

/// One uploaded file, which one message of the actor that uploaded it can send once.
model SuperTabAttachment {
  id             String   @id @map("_id")
  tabId          String
  conversationId String
  actorKey       String
  name           String
  mime           String
  size           Int
  objectKey      String
  usedBy         String?
  /// `avatar` for a profile picture (superTabs/profile.ts), which no message sends; absent on a chat file.
  purpose        String?
  createdAt      DateTime @default(now())

  @@index([tabId, actorKey, createdAt])
}

model SuperTabOperation {
  id           String   @id @map("_id")
  tabId        String
  actorKey     String
  requestHash  String
  revision     Int
  result       Json
  /// The parts a command wrote, with their versions, returned again on a replay. Absent on receipts from before parts.
  parts        Json?
  createdAt    DateTime @default(now())

  @@index([tabId])
}

// A conversation-scoped provenance receipt. It grants no terminal access.
// Only the recorded execution host can append observations, and every append
// rechecks the person's membership and both machine grants.
model SuperTabNativeContext {
  id              String   @id @map("_id")
  tabId           String
  conversationId  String
  agentId         String
  userId          String
  binding         Json
  lastEventId     String?
  revoked         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([tabId, revoked])
}

model SuperTabDelivery {
  id                    String   @id @map("_id")
  tabId                 String
  conversationId        String
  messageId             String
  nativeContextId       String?
  assignmentId          String?
  agentId               String
  machineId             String
  machineOwnerId        String?
  membershipGeneration  String
  authorKind            String
  authorId              String
  authorGeneration      String
  status                String   @default("queued")
  claimId               String?
  receipt               String?
  // Optional on older records: backend first, then Desktop's inline receipt.
  holdReason            String?
  holdSince             DateTime?
  deliveredAt           DateTime?
  answeredAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tabId, agentId, status, createdAt])
  @@index([machineId, status])
}

// One independent harness owns at most one active assignment across all Super Tabs.
model SuperTabRun {
  id            String   @id @map("_id")
  tabId         String
  assignmentId  String   @unique
  machineId     String
  harnessId     String
  createdAt     DateTime @default(now())
}

// One routing policy document per account and environment (superTabs/routingPolicy.ts).
model RoutingPolicy {
  id            String   @id @map("_id")
  userId        String
  autonomousEnv String
  revision      Int      @default(0)
  policy        Json
  updatedAt     DateTime @updatedAt

  @@unique([userId, autonomousEnv])
}

model SuperTabAttempt {
  id              String   @id @map("_id")
  tabId           String
  conversationId  String
  snapshot        Json
  createdAt       DateTime @default(now())

  @@index([tabId, conversationId, createdAt])
}

/// One `harness super-tab route` decision (superTabs/routeRecord.ts). Pruned after 90 days on write.
model SuperTabRouteDecision {
  id             String    @id @map("_id")
  tabId          String
  conversationId String
  record         Json
  final          Json?
  override       Json?
  assignmentId   String?
  outcome        String?
  outcomeAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([tabId, createdAt])
  @@index([tabId, conversationId, outcome])
  @@index([tabId, assignmentId])
}

model SuperTabStopReceipt {
  id              String   @id @map("_id")
  tabId           String
  assignmentId    String
  machineId       String
  harnessId       String
  machineOwnerId  String
  receipt         String
  createdAt       DateTime @default(now())

  @@unique([tabId, assignmentId])
}

// A custom role's skill text (superTabs/projects.ts ProjectRole), outside the tab snapshot: the snapshot keeps only
// its version, so tab reads and host rosters stay small. Hosts fetch the text when the version changes.
model SuperTabRoleText {
  id        String @id @map("_id")
  tabId     String
  projectId String
  roleId    String
  version   String
  text      String

  @@index([tabId, projectId])
}

// Configuration observations stay outside the tab snapshot so a long-running
// assignment keeps its complete history without making every tab read grow.
model SuperTabConfiguration {
  id             String   @id @map("_id")
  tabId          String
  agentId        String
  revision       Int
  configuration  Json
  assignmentIds  String[]
  actorKey       String
  observedAt     DateTime

  @@index([tabId, agentId, revision])
}

// A Lead's read of, or input to, an agent's terminal, relayed to the host of the agent's machine
// (backend/src/superTabs/terminal.ts). Outside the tab snapshot and history: a screen can show secrets,
// so its text is kept only until the requester reads it.
model SuperTabTerminalRequest {
  id             String    @id @map("_id")
  tabId          String
  agentId        String
  machineId      String
  machineOwnerId String
  harnessId      String
  requesterKey   String
  kind           String
  scrollback     Int?
  text           String?
  keys           String[]  @default([])
  /// pending -> claimed (handed to the host once) -> done
  status         String    @default("pending")
  ok             Boolean?
  result         String?
  error          String?
  createdAt      DateTime
  claimedAt      DateTime?

  @@index([machineId, status])
  @@index([tabId, createdAt])
}

// Swarm state by parts (docs/design/2026-10-26-swarm-state-parts.md). Each part is one record of a Swarm, written only
// by the commands that change it. `version` moves on every write and every guarded touch and never resets; `changedAt`
// moves only when `data` changes, and is what readers ask for changes by. A removed part stays as a tombstone
// (`deleted`) until `purgeAt`, so readers learn it is gone. `data` keeps the record's shape from `SuperTab.state`.

/// The Swarm's scalars and settings: projects (without progress), rules, invitations, sharing, routing, Local models.
/// A Workspace: Swarms and the people who may be in them (docs/plans/2026-10-27-swarm-workspaces.md). Not the Harness Team
/// account. It never grants reading a Swarm: that needs the Swarm's own membership too.
model SwarmWorkspace {
  id            String    @id @map("_id")
  autonomousEnv String
  name          String
  ownerId       String
  revision      Int       @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  purgeAt       DateTime?
}

/// One person of a Workspace. A removal keeps the row with `removedAt` until it is purged; a rejoin writes a new generation.
model SwarmWorkspaceMember {
  /// `workspaceId:userId`
  id         String    @id @map("_id")
  workspaceId      String
  userId     String
  email      String
  role       String
  generation String
  version    Int       @default(1)
  addedBy    String
  addedAt    DateTime  @default(now())
  removedAt  DateTime?
  removedBy  String?
  purgeAt    DateTime?

  @@index([workspaceId, removedAt])
  @@index([userId, removedAt])
}

/// One removal of one Workspace membership, open until the person has left every Swarm of the Workspace. While one is open the
/// person cannot be brought back into the Workspace; the hourly sweep finishes them in order (superTabs/workspaceStore.ts).
model SwarmWorkspaceRemoval {
  /// `workspaceId:userId:generation`: the membership generation that was removed.
  id            String    @id @map("_id")
  workspaceId         String
  userId        String
  email         String
  generation    String
  autonomousEnv String
  removedAt     DateTime
  removedBy     String
  finishedAt    DateTime?
  purgeAt       DateTime?

  @@index([finishedAt, id])
  @@index([workspaceId, userId, finishedAt])
}

/// An invitation to a Workspace, by email; deleted when accepted or revoked, purged when it expires.
model SwarmWorkspaceInvitation {
  /// `workspaceId:email`
  id        String   @id @map("_id")
  workspaceId     String
  email     String
  role      String
  invitedBy String
  expiresAt DateTime

  @@index([email, expiresAt])
  @@index([workspaceId])
}

model SwarmHead {
  id              String    @id @map("_id")
  tabId           String
  key             String
  version         Int
  changedAt       DateTime
  deleted         Boolean   @default(false)
  purgeAt         DateTime?
  ordinal         Float
  data            Json
  /// Workgroup numbers are never given twice, whatever was deleted or went dormant.
  groupCounter    Int       @default(0)
  /// Moves when who may see what changes; a reader with an older epoch loads in full.
  visibilityEpoch Int       @default(1)
  /// The tab revision when it was split into parts (0 for a Swarm born in parts). Every later message sequence is above it.
  sequenceBase    Int       @default(0)

  @@unique([tabId, key])
  @@index([tabId, changedAt])
}

/// One person in the Swarm. Every command of theirs touches it, so removing them and their in-flight action cannot both win.
model SwarmMember {
  id        String    @id @map("_id")
  tabId     String
  key       String
  version   Int
  changedAt DateTime
  deleted   Boolean   @default(false)
  purgeAt   DateTime?
  ordinal   Float
  data      Json

  @@unique([tabId, key])
  @@index([tabId, changedAt])
}

/// One conversation: its work, checks, assignment, members and message counter.
model SwarmGroup {
  id                 String    @id @map("_id")
  tabId              String
  key                String
  version            Int
  changedAt          DateTime
  deleted            Boolean   @default(false)
  purgeAt            DateTime?
  ordinal            Float
  data               Json
  projectId          String?
  kind               String?
  archived           Boolean   @default(false)
  /// Out of first loads and changes: work done or cancelled and quiet for a day, or archived by hand. A message wakes it.
  dormant            Boolean   @default(false)
  agentIds           String[]
  /// The machine running its active assignment, for the host's change read.
  executionMachineId String?
  messageSeq         Int       @default(0)
  reportSeq          Int       @default(0)
  lastActivityAt     DateTime
  /// The machines whose hosts this group's last write concerned: its agents' and its work's, before and after (host reads).
  hostMachineIds     String[]  @default([])
  /// A short hash of the fields host rows read (read/hostRows.ts); a post leaves it. Missing on a part written before it.
  hostDigest         String?
  /// Its task is done or cancelled: all the archive pass reads (superTabs/archive.ts). Marked at worker startup on a part
  /// written before it (markFinishedGroups).
  workFinished       Boolean   @default(false)

  @@unique([tabId, key])
  @@index([tabId, changedAt])
  @@index([tabId, dormant, changedAt])
  @@index([tabId, agentIds])
  @@index([tabId, projectId, dormant, lastActivityAt])
  @@index([tabId, projectId, dormant, reportSeq])
  @@index([dormant, lastActivityAt])
  @@index([workFinished, archived, lastActivityAt])
  @@index([executionMachineId])
}

model SwarmAgent {
  id             String    @id @map("_id")
  tabId          String
  key            String
  version        Int
  changedAt      DateTime
  deleted        Boolean   @default(false)
  purgeAt        DateTime?
  ordinal        Float
  data           Json
  machineId      String
  machineOwnerId String
  contributorId  String

  @@unique([tabId, key])
  @@index([tabId, changedAt])
  @@index([machineId, deleted])
  @@index([tabId, contributorId])
}

/// One machine the Swarm references, contributed or not: its contribution and observation, and its slot ledger.
model SwarmMachine {
  id              String    @id @map("_id")
  tabId           String
  key             String
  version         Int
  changedAt       DateTime
  deleted         Boolean   @default(false)
  purgeAt         DateTime?
  ordinal         Float
  data            Json
  machineId       String
  contributed     Boolean   @default(false)
  cleanupOwnerIds String[]
  /// The last change to its settings or ledger, never its own reading (host reads wake on this, not on changedAt).
  hostChangedAt   DateTime?

  @@unique([tabId, key])
  @@index([tabId, changedAt])
  @@index([machineId, deleted])
}

model SwarmStart {
  id             String    @id @map("_id")
  tabId          String
  key            String
  version        Int
  changedAt      DateTime
  deleted        Boolean   @default(false)
  purgeAt        DateTime?
  ordinal        Float
  data           Json
  machineId      String
  conversationId String
  /// The agent it started, once it has a harness: an agent's own removal and a routed assignment find it by this.
  agentId        String?
  /// Failed, or started and settled: out of command state, still loadable by key or agent until it expires 7 days later.
  finishedAt     DateTime?

  @@unique([tabId, key])
  @@index([tabId, changedAt])
  @@index([tabId, finishedAt])
  @@index([machineId, finishedAt])
  @@index([tabId, agentId])
