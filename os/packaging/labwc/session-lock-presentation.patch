@@ -185,6 +207,29 @@
 	if (event->state->committed & require_reconfigure) {
 		lock_output_reconfigure(output);
 	}
+	if (event->state->committed & WLR_OUTPUT_STATE_ENABLED) {
+		output->locked_frame_presented = false;
+		output->frame_pending = false;
+	}
+	if ((event->state->committed & WLR_OUTPUT_STATE_BUFFER)
+			&& !output->locked_frame_presented) {
+		output->frame_pending = true;
+		output->frame_commit_seq = event->output->commit_seq;
+	}
+	send_locked_when_presented(output->manager);
+}
+
+static void
+handle_output_present(struct wl_listener *listener, void *data)
+{
+	struct wlr_output_event_present *event = data;
+	struct session_lock_output *output = wl_container_of(listener, output, present);
+	if (output->frame_pending && event->presented
+			&& event->commit_seq == output->frame_commit_seq) {
+		output->locked_frame_presented = true;
+		output->frame_pending = false;
+		send_locked_when_presented(output->manager);
+	}
 }
 
