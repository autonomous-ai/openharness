+	uint32_t frame_commit_seq;
 
 	struct wl_list link; /* session_lock_manager.lock_outputs */
 
 	struct wl_listener destroy;
 	struct wl_listener commit;
+	struct wl_listener present;
 	struct wl_listener surface_destroy;
 	struct wl_listener surface_map;
 };
+
+static void
+send_locked_when_presented(struct session_lock_manager *manager)
+{
+	if (!manager->lock || !manager->ack_pending) {
+		return;
+	}
+	struct session_lock_output *output;
+	wl_list_for_each(output, &manager->lock_outputs, link) {
+		if (output->output->wlr_output->enabled
+				&& !output->locked_frame_presented) {
+			return;
+		}
+	}
+	manager->ack_pending = false;
+	wlr_session_lock_v1_send_locked(manager->lock);
+}
 
