#!/usr/bin/env python3
"""System operations callable from an agent's ordinary shell."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def capture(*args):
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return {'exit_status': result.returncode, 'output': result.stdout.strip()}


def cpu_ticks():
    # user/nice/system/idle/iowait/irq/softirq/steal; guest times are already in user/nice.
    values = [int(value) for value in Path('/proc/stat').read_text().splitlines()[0].split()[1:9]]
    return sum(values), values[3] + values[4]


def connected():
    result = subprocess.run(['nmcli', '--wait', '5', '-t', '-f', 'STATE', 'general'],
                            text=True, capture_output=True, timeout=8, env=dict(os.environ, LC_ALL='C'))
    return result.returncode == 0 and result.stdout.strip() == 'connected'


def wifi():
    # Reuse NetworkManager's keyboard UI; it owns password entry and storage.
    # Never put a Wi-Fi password in shell arguments, logs, or our own config.
    subprocess.run(['sudo', 'nmcli', 'radio', 'wifi', 'on'], check=False)
    return subprocess.call(['sudo', 'nmtui-connect'])


def opencode_cpu_ready():
    try:
        lines = Path('/proc/cpuinfo').read_text().splitlines()
    except OSError:
        return True
    for line in lines:
        key, separator, value = line.partition(':')
        if separator and key.strip() == 'flags':
            return 'sse4_2' in value.split()
    return True  # The x86 instruction check does not apply to an ARM CPU.


def try_harness():
    if not opencode_cpu_ready():
        print('The bundled OpenCode needs a newer CPU (SSE4.2).')
        print('Open a terminal to work locally or connect to a remote agent.')
        if sys.stdin.isatty():
            input('Press Enter to return to Harness.')
        return
    if not connected():
        if wifi() != 0 or not connected():
            print('OpenCode needs an internet connection. Connect to Wi-Fi or plug in Ethernet, then try again.')
            if sys.stdin.isatty():
                input('Press Enter to return to Harness.')
            return
    projects = Path.home() / 'Projects'
    projects.mkdir(exist_ok=True)
    os.chdir(projects)
    os.execv('/usr/bin/opencode', ['opencode'])


def main():
    args = sys.argv[1:]
    command = args.pop(0) if args else 'status'
    if command == 'install':
        os.execv('/usr/bin/python3', ['python3', '/usr/lib/harness-os/install.py', *args])
    if command == 'browser':
        os.execv('/usr/bin/hn-browser', ['hn-browser', *args])
    if command == 'wifi':
        raise SystemExit(wifi())
    if command == 'try':
        try_harness()
        return
    if command == 'hardware':
        os.execv('/usr/bin/python3', ['python3', '/usr/lib/harness-os/hardware.py', 'report', *args])
    if command in ['checkpoint', 'update', 'recover']:
        os.execv('/usr/bin/python3', ['python3', '/usr/lib/harness-os/system.py', command, *args])
    if command == 'status':
        print(Path('/usr/share/harness-os/lock.json').read_text())
        subprocess.run(['systemctl', '--user', '--no-pager', 'status', 'harness-daemon', 'hn-screen'])
        return
    if command == 'measure':
        before, idle_before = cpu_ticks()
        time.sleep(2)
        after, idle_after = cpu_ticks()
        memory = {line.split(':')[0]: int(line.split()[1]) for line in Path('/proc/meminfo').read_text().splitlines()}
        disk = os.statvfs('/')
        data = {'uptime_seconds': float(Path('/proc/uptime').read_text().split()[0]),
                'memory_total_mib': round(memory['MemTotal'] / 1024, 2),
                'memory_used_excluding_available_mib': round((memory['MemTotal'] - memory['MemAvailable']) / 1024, 2),
                'cpu_busy_percent_over_2s': round(100 * (1 - (idle_after - idle_before) / max(1, after - before)), 2),
                'root_filesystem_used_bytes_including_home_and_snapshots': (disk.f_blocks - disk.f_bfree) * disk.f_frsize,
                'boot': capture('systemd-analyze'),
                'screen_service_started_monotonic_usec': capture('systemctl', '--user', 'show', 'hn-screen', '--property=ActiveEnterTimestampMonotonic', '--value'),
                'processes_rss_kib_and_lifetime_cpu': capture('ps', '-eo', 'comm,rss,pcpu', '--sort=-rss')}
        print(json.dumps(data, indent=2))
        return
    raise SystemExit('Usage: hn-os [status | hardware | try | wifi | install | browser [URL] | measure | checkpoint | update [--snapshot YYYY/MM/DD] | recover ROOT_DEVICE [CHECKPOINT]]')


if __name__ == '__main__':
    main()
