#!/bin/sh
# Type=exec establishes a process, not an agent runtime ready to accept hn.
# Keep startup ordering honest without a second persistent supervisor.
#
# Asked over the daemon's own Unix socket, which the filesystem limits to this user: over the
# loopback port a caller without the local credential is answered only which daemon this is (cli
# hookServer.ts publicStatus), never `discoveryReady`, and the unit failed every start, the daemon
# restarted every 35 s (2026-10-20). The port says where the socket is.
set -eu
for attempt in $(seq 1 120); do
    socket=$(curl --fail --silent --max-time 1 http://127.0.0.1:18473/api/status | jq -r '.localSocket // empty' 2>/dev/null || true)
    if [ -n "$socket" ] && [ -S "$socket" ] &&
        curl --fail --silent --max-time 1 --unix-socket "$socket" http://localhost/api/status |
        jq -e '.discoveryReady == true and .safeMode != true' >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.25
done
printf '%s\n' 'Harness runtime did not become ready; see journalctl --user -u harness-daemon.' >&2
exit 1
