#!/bin/sh
# Runs in the computer's startup (initramfs) while the disk waits for its password, beside `run`: the
# power button's factory reset (os/button.py, once the system runs), for a computer whose password
# nobody has. Five presses in a row ask — the lights blink fast, the screen says so — and one press
# more within ten seconds starts the computer in its recovery (installer.py recover), which installs it
# again as it came: everything erased, a new disk key, the password 1234. Nothing more and it waits for
# its password as before. A computer installed without a recovery has nothing to start: this rests.
#
# busybox sh: presses read with od from every input device with KEY_POWER, timed by /proc/uptime in
# hundredths of a second; the recovery asked for in GRUB's environment block on the boot partition.
#
#   button devices      the input devices it listens to, one a line (for the tests)
#   button grubenv F    writes F as GRUB's environment block, the recovery its next start (the tests)
set -u
STATE=${HARNESS_BUTTON_STATE:-/run/harness-button}
DEVICES=${HARNESS_BUTTON_DEVICES:-/proc/bus/input/devices}
INPUT=${HARNESS_BUTTON_INPUT:-/dev/input}
RECOVERY=${HARNESS_BUTTON_RECOVERY:-/dev/disk/by-label/HN_RECOVERY}
BOOT=${HARNESS_BUTTON_BOOT:-/dev/disk/by-label/HNBOOT}
LEDS=/sys/class/leds
ENTRY=harness-recovery
PRESSES=5
# In hundredths of a second, as button.py's: a pause that starts the count again, one press seen by
# two devices, presses still coming as it asks, and how long it waits for the answer.
GAP=300
SAME=15
SETTLE=100
CONFIRM=1000

log() { echo "harness-button: $*"; }

# The handlers of every device whose key bits have KEY_POWER (116): bit 52 of the second word from the
# right, the words being the kernel's 64-bit longs. Through cat: busybox's read, on the /proc file
# itself, reads it again and again without end.
devices() {
    handlers=
    cat "$DEVICES" | while read -r line; do
        case $line in
            'H: Handlers='*) handlers=${line#*Handlers=} ;;
            'B: KEY='*)
                set -- ${line#B: KEY=}
                [ $# -ge 2 ] || continue
                eval "word=\${$(($# - 1))}"
                # Bit 52 is the lowest of the 14th hex digit from the right: that digit alone, as
                # the whole word overflows a shell's signed arithmetic (dash saturates it).
                [ ${#word} -ge 14 ] || continue
                digit=${word%?????????????}
                digit=${digit#"${digit%?}"}
                [ $((0x$digit & 1)) -eq 1 ] || continue
                for handler in $handlers; do
                    case $handler in event*) echo "$handler" ;; esac
                done ;;
        esac
    done
}

grubenv() {
    text="# GRUB Environment Block
# WARNING: Do not edit this file by tools other than grub-editenv!!!
next_entry=$ENTRY
"
    { printf '%s' "$text"; head -c $((1024 - ${#text})) /dev/zero | tr '\0' '#'; } > "$1"
}

case ${1:-} in
    devices) devices; exit 0 ;;
    grubenv) grubenv "$2"; exit 0 ;;
esac

rest() { while :; do sleep 3600; done; }

now() {
    up=$(cat /proc/uptime)
    up=${up%% *}
    echo $((${up%.*} * 100 + 1${up#*.} - 100))
}

blink() {
    for led in "$LEDS"/*::capslock; do
        [ -e "$led/brightness" ] && echo none > "$led/trigger" 2>/dev/null
    done
    on=1
    while :; do
        for led in "$LEDS"/*::capslock; do
            [ -e "$led/brightness" ] || continue
            if [ $on = 1 ]; then cat "$led/max_brightness" > "$led/brightness"; else echo 0 > "$led/brightness"; fi
        done 2>/dev/null
        on=$((1 - on))
        sleep 0.1
    done
}

say() { command -v plymouth >/dev/null 2>&1 && plymouth display-message --text="reset:$1" 2>/dev/null; }

ask() {
    log "$PRESSES presses: asking for a factory reset"
    blink &
    echo $! > "$STATE/blink.pid"
    shown=$((CONFIRM / 100))
    say "ask:$shown"
}

# The seconds left to answer, on the screen as they change.
countdown() {
    left=$(((CONFIRM - ($(now) - asked) + 99) / 100))
    [ "$left" -lt 1 ] || [ "$left" = "$shown" ] && return
    shown=$left
    say "ask:$left"
}

keep() {
    log 'no answer: nothing reset'
    [ -f "$STATE/blink.pid" ] && kill "$(cat "$STATE/blink.pid")" 2>/dev/null
    for led in "$LEDS"/*::capslock; do
        [ -e "$led/brightness" ] && echo 0 > "$led/brightness" 2>/dev/null
    done
    say ''
}

reset() {
    log 'factory reset: starting again in the recovery'
    say now
    mkdir -p "$STATE/boot"
    if mount -t vfat "$BOOT" "$STATE/boot"; then
        [ -d "$STATE/boot/grub" ] && grubenv "$STATE/boot/grub/grubenv"
        umount "$STATE/boot"
        sync
        systemctl reboot
        rest
    fi
    log 'the boot partition did not open: nothing reset'
    keep
}

mkdir -p "$STATE"
# The recovery's partition label appears once udev has seen the disk.
for _ in $(seq 30); do
    [ -e "$RECOVERY" ] && break
    sleep 1
done
[ -e "$RECOVERY" ] || { log 'no recovery on this computer'; rest; }
events=$(devices)
[ -n "$events" ] || { log 'no power button to listen to'; rest; }

rm -f "$STATE/presses"
mkfifo "$STATE/presses"
# Read and write: the readers below open it without waiting, and read never meets its end.
exec 3<> "$STATE/presses"
# One event (24 bytes) a time, the device opened once: od on the whole device keeps what it reads
# until it has 4096 bytes for its pipe, some forty presses.
for event in $events; do
    while line=$(dd bs=24 count=1 2>/dev/null <&4 | od -An -tx1 -w24 -v); do
        [ -n "$line" ] || break
        set -- $line
        # type EV_KEY (1), code KEY_POWER (0x74), value 1: pressed.
        [ $# -ge 21 ] && [ "${17}${18}${19}${20}${21}" = 0100740001 ] && echo pressed
    done 4< "$INPUT/$event" > "$STATE/presses" &
done
log "listening to $(echo $events | wc -w) power button device(s)"

count=0
last=-10000
asked=
while :; do
    if read -r -t 1 _ <&3; then
        at=$(now)
        [ $((at - last)) -lt $SAME ] && continue
        if [ -n "$asked" ]; then
            last=$at
            [ $((at - asked)) -lt $SETTLE ] && continue
            reset
            asked=
            count=0
            continue
        fi
        [ $((at - last)) -gt $GAP ] && count=0
        last=$at
        count=$((count + 1))
        if [ $count -ge $PRESSES ]; then
            asked=$at
            count=0
            ask
        fi
    else
        if [ -n "$asked" ] && [ $(($(now) - asked)) -ge $CONFIRM ]; then
            asked=
            count=0
            keep
        elif [ -n "$asked" ]; then
            countdown
        fi
    fi
done
