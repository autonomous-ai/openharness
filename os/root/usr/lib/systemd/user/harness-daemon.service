[Unit]
Description=Harness agent runtime

[Service]
Type=exec
Environment=ADAPTER_UPDATE_DISABLE=true
Environment=HARNESS_TUI_BIN=/usr/lib/harness/hn
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=npm_config_prefix=%h/.local
Environment=BROWSER=hn-browser
ExecStart=/usr/bin/harness start --foreground
Restart=on-failure
RestartSec=2
KillMode=process

[Install]
WantedBy=default.target
