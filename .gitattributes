# Hardware/mechanical/PCB design files — treat as binary so autocrlf never rewrites them.
*.step binary
*.stp binary
*.stl binary
*.epro2 binary
*.pdf binary
*.xlsx binary
*.zip binary

# Windows scripts. install.ps1 is published byte for byte and its spec reads it as LF; cmd needs CRLF to parse a
# batch file's labels reliably. Without these, core.autocrlf (GitHub's Windows images set it) decides.
*.ps1 text eol=lf
*.cmd text eol=crlf

# Signed test fixtures: a signature holds for these exact bytes, so core.autocrlf must never rewrite a line end.
desktop/test/fixtures/tauri_signature/** -text

# The device plugin's hook scripts: sh runs each by its path, and a CRLF would break its lines. cli.js carries their
# bytes from the checkout it is built in, a Windows one too, where core.autocrlf would otherwise decide.
plugins/harness-device/hooks/asked text eol=lf
plugins/harness-device/hooks/codex-asked text eol=lf
plugins/harness-device/hooks/start text eol=lf
plugins/harness-device/hooks/stop text eol=lf
plugins/harness-device/hooks/codex-start text eol=lf
plugins/harness-device/hooks/codex-stop text eol=lf
