{
  "spec": 1,
  "id": "autonomous/blender",
  "name": "Blender",
  "category": "3D",
  "author": "Blender Foundation",
  "description": "Describe an object or scene, then shape it with authored controls: real Blender geometry, named design directions, and editable source you can keep and rebuild.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "scenes/hello.py",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "BLENDER_PYTHON": "${dsh}/.venv/bin/python",
      "BLENDER_TOOLCHAIN": "${dsh}/toolchain",
      "PYTHONPATH": "${dsh}/toolchain"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/model-viewer",
    "artifactExtensions": [
      ".glb",
      ".gltf"
    ]
  },
  "verdict": ".harness/verdict.json"
}
