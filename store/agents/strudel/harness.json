{
  "spec": 1,
  "id": "autonomous/strudel",
  "name": "Strudel",
  "category": "Music",
  "author": "Strudel",
  "description": "Describe a track and perform it live in Strudel's own REPL. Mute voices, change code, mark a moment, and keep the actual performance as audio with its editable source.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "track.strudel",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills"],
    "env": {
      "STRUDEL_TOOLCHAIN": "${dsh}/toolchain"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "./viewer.sh",
    "url": "http://127.0.0.1:${port}/?file=${artifact}",
    "artifactExtensions": [".strudel"]
  },
  "verdict": ".harness/verdict.json"
}
