{
  "spec": 1,
  "id": "autonomous/ollama",
  "name": "Ollama",
  "category": "Local AI",
  "author": "OpenHarness contributors",
  "description": "Run local language models by talking to Codex. A live viewer shows Ollama models, memory, deployment progress and measured performance on your Mac.",
  "engine": "codex",
  "workspace": {
    "template": "template",
    "marker": "local-ai.json"
  },
  "agent": {
    "instructions": "agent/AGENTS.md",
    "env": {
      "LOCAL_AI": "${dsh}/toolchain/local-ai.mjs"
    }
  },
  "toolchain": {
    "setup": "node toolchain/setup.mjs",
    "doctor": "node toolchain/doctor.mjs"
  },
  "viewer": {
    "command": "node toolchain/viewer.mjs",
    "url": "http://127.0.0.1:${port}/?view=grid"
  },
  "verdict": ".harness/verdict.json"
}
