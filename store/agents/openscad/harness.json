{
  "spec": 1,
  "id": "autonomous/openscad",
  "name": "OpenSCAD",
  "category": "CAD",
  "author": "OpenSCAD",
  "description": "Turn measurements into parametric part families: compare fit variants, verify actual meshes, and download print-oriented STLs with an independently rebuildable project.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "model.scad",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "OPENSCAD_TOOLCHAIN": "${dsh}/toolchain",
      "OPENSCAD_SKILLS": "${dsh}/skills"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/cad-viewer",
    "artifactExtensions": [
      ".stl",
      ".3mf"
    ]
  },
  "verdict": ".harness/verdict.json"
}
