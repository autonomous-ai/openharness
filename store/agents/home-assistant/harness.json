{
  "spec": 1,
  "id": "autonomous/home-assistant",
  "name": "Home Assistant",
  "category": "Automation",
  "author": "OpenHarness contributors",
  "description": "Turn a home-automation idea into editable YAML tested by the real Home Assistant engine. Explore what-if scenarios, follow native traces, and export a reviewed installation kit—no devices required to start.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "automations.yaml",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills"],
    "env": {
      "HA_TOOLCHAIN": "${dsh}/toolchain",
      "HA_SKILLS": "${dsh}/skills",
      "HA_DSH_DIR": "${dsh}"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/",
    "artifactExtensions": [".html"]
  },
  "verdict": ".harness/verdict.json"
}
