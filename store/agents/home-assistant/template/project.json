{
  "spec": 1,
  "title": "A hallway that works around you",
  "brief": "Turn on the hallway after two seconds of motion when it is dark. Use 12% brightness in quiet hours and 45% otherwise. Keep the light on while people return, then turn it off after two clear minutes. A manual-hold helper must prevent automatic on and off actions. Reject brief motion glitches and unknown light readings.",
  "example": true,
  "timezone": "Europe/London",
  "latitude": 51.5074,
  "longitude": -0.1278,
