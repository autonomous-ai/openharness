    {
      "id": "binary_sensor.example_hall_motion",
      "name": "Hallway motion",
      "kind": "state",
      "state": "off",
      "attributes": {
        "device_class": "motion"
      }
    },
    {
      "id": "sensor.example_hall_lux",
      "name": "Hallway illuminance",
      "kind": "state",
      "state": "12",
      "attributes": {
        "unit_of_measurement": "lx"
      }
    },
    {
      "id": "input_boolean.example_quiet_hours",
      "name": "Quiet hours",
      "kind": "input_boolean",
      "state": "off",
      "attributes": {}
    },
    {
