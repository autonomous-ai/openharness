{
  "spec": 1,
  "id": "autonomous/godogen",
  "name": "Godogen",
  "category": "Games",
  "author": "Alex Ermolov",
  "description": "Build a world you can play. Rewind a run, try another move, and pin a moment for your agent to improve while your game keeps taking shape.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "studio.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills", "runtime/.claude/skills"],
    "env": {
      "GODOGEN_TOOLS": "${dsh}/toolchain",
      "GODOGEN_RUNTIME": "${dsh}/runtime"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": { "use": "autonomous/game-viewer" },
  "verdict": ".harness/verdict.json"
}
