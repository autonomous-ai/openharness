#!/usr/bin/env bash
# The one command this harness gives its agent. Everything runs on the package's own interpreter
# and the package's own ffmpeg; nothing is expected on PATH.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG="$(cd "$HERE/.." && pwd)"
PY="$PKG/toolchain/.venv/bin/python"
[ -x "$PY" ] || { echo "miss the Python environment is not installed — run $PKG/toolchain/setup.sh" >&2; exit 1; }
[ -x "$PKG/toolchain/.conda/bin/ffmpeg" ] || { echo "miss ffmpeg is not installed — run $PKG/toolchain/setup.sh" >&2; exit 1; }
export EPISODE_PACKAGE="$PKG"
export EPISODE_FFMPEG="$PKG/toolchain/.conda/bin/ffmpeg"
export EPISODE_FFPROBE="$PKG/toolchain/.conda/bin/ffprobe"
export PYTHONPATH="$HERE/lib${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec "$PY" -m ep.cli "$@"
