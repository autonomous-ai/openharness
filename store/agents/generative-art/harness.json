{
  "spec": 1,
  "id": "autonomous/generative-art",
  "name": "Generative Art",
  "category": "Original art",
  "author": "Autonomous",
  "description": "Turn your brief into original vector artwork with its own drawing program and controls. Use your text, images and data; revise multiple layouts; export SVG, PNG, editions and complete editable projects.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "sketch/index.html",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "GENART_DSH_DIR": "${dsh}"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/web-viewer",
    "artifactExtensions": [
      ".html"
    ],
    "url": "http://127.0.0.1:${port}/?file=${artifact}"
  },
  "verdict": ".harness/verdict.json"
}
