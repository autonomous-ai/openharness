# Pocket / a parametric two-piece electronics enclosure, millimetres.
# Build with build-part.sh; exports a real STEP assembly, mesh and FreeCAD document.
# Edit dimensions here, then rebuild. Clearances are design inputs, not certified fit.
import os
import FreeCAD as App
import Part
import MeshPart

length, width, height = 92.0, 60.0, 26.0
wall, floor, corner_radius = 2.4, 2.8, 6.0
lid_thickness, lip_height, clearance = 2.4, 2.0, 0.3
screw_diameter, boss_radius, boss_inset = 3.4, 4.4, 9.0
vent_count, vent_width, vent_length = 7, 2.2, 22.0

assert min(length, width) > 2 * (boss_inset + boss_radius)
assert height > floor + 6 and 1.2 <= wall < corner_radius < min(length, width) / 2
assert min(floor, lid_thickness) >= 1.2 and 0 < clearance < wall
assert screw_diameter / 2 < boss_radius and vent_count >= 1
outdir = os.environ.get("HARNESS_BUILD_DIR", os.getcwd())
doc = App.newDocument("Pocket")

def rounded_box(l, w, h, radius):
    shape = Part.makeBox(l, w, h, App.Vector(-l/2, -w/2, 0))
    vertical = [edge for edge in shape.Edges if edge.BoundBox.ZLength > h - 1e-7
                and edge.BoundBox.XLength < 1e-7 and edge.BoundBox.YLength < 1e-7]
    return shape.makeFillet(radius, vertical)

shell = rounded_box(length, width, height, corner_radius)
cavity = rounded_box(length-2*wall, width-2*wall, height, corner_radius-wall)
cavity.translate(App.Vector(0, 0, floor))
shell = shell.cut(cavity)
positions = [(x, y) for x in [-length/2+boss_inset, length/2-boss_inset]
             for y in [-width/2+boss_inset, width/2-boss_inset]]
for x, y in positions:
    boss = Part.makeCylinder(boss_radius, height-floor-3, App.Vector(x, y, floor-0.01))
    hole = Part.makeCylinder(screw_diameter/2, height, App.Vector(x, y, floor))
    shell = shell.fuse(boss).cut(hole)
# A cable opening in the near wall, intentionally open to the cavity.
shell = shell.cut(Part.makeBox(12, wall+0.2, 7, App.Vector(-6, -width/2-0.1, floor+3)))
shell = shell.removeSplitter()

lid = rounded_box(length, width, lid_thickness, corner_radius)
lip_outer = rounded_box(length-2*(wall+clearance), width-2*(wall+clearance), lip_height,
                        corner_radius-wall-clearance)
lip_inner = rounded_box(length-2*(2*wall+clearance), width-2*(2*wall+clearance), lip_height+0.2,
                        max(0.5, corner_radius-2*wall-clearance))
lip_inner.translate(App.Vector(0, 0, -0.1))
lip = lip_outer.cut(lip_inner)
lip.translate(App.Vector(0, 0, lid_thickness-0.01))
lid = lid.fuse(lip)
for x, y in positions:
    lid = lid.cut(Part.makeCylinder(screw_diameter/2, lid_thickness+lip_height+2, App.Vector(x, y, -1)))
for i in range(int(vent_count)):
    x = (i-(vent_count-1)/2)*5.5
    lid = lid.cut(Part.makeBox(vent_width, vent_length, lid_thickness+2,
                             App.Vector(x-vent_width/2, -vent_length/2, -1)))
lid = lid.removeSplitter()
lid.translate(App.Vector(length+14, 0, 0))  # laid out beside the base for inspection

features = []
for name, shape in [("Base", shell), ("Lid", lid)]:
    if not shape.isValid() or not shape.isClosed() or len(shape.Solids) != 1:
        raise RuntimeError(name + " is not one closed, valid solid")
    shape.check(True)  # raises on BRep errors; it does not return a boolean
    feature = doc.addObject("Part::Feature", name)
    feature.Label = name
    feature.Shape = shape
    features.append(feature)
parameters = doc.addObject("App::FeaturePython", "DesignInputs")
for name, value in [("Length",length),("Width",width),("Height",height),("Wall",wall),("Clearance",clearance)]:
    parameters.addProperty("App::PropertyLength", name, "Dimensions", "Source parameter; edit the macro and rebuild")
    setattr(parameters, name, value)
doc.recompute()
doc.saveAs(os.path.join(outdir, "part.FCStd"))
Part.export(features, os.path.join(outdir, "part.step"))
mesh = MeshPart.meshFromShape(Shape=Part.makeCompound([shell,lid]),
                             LinearDeflection=0.1, AngularDeflection=0.15, Relative=False)
mesh.write(os.path.join(outdir, "part.stl"))
App.closeDocument(doc.Name)
print("Exported Pocket: base + vented lid")
