{
  "spec": "forme/1",
  "id": "stillwater-ceramics",
  "title": "Stillwater — community ceramics",
  "brief": "Create an identity and workshop launch for a fictional community ceramics studio. Make the work feel tactile and considered while keeping it welcoming to beginners. Deliver studio identity, an open-day poster, a product tag, a workshop announcement, a calling card, and a responsive site. Product drawings and business facts are authored acceptance fixtures.",
  "copy": {
    "name": "Stillwater",
    "category": "A community ceramics studio",
    "headline": "Make room\nfor making.",
    "tagline": "Clay. Company. Time.",
    "description": "A place to work with your hands, learn from each other, and make objects that belong in everyday life. Come as you are. Begin with a piece of clay.",
    "offer": "Open studio\nSunday · 11am–4pm",
    "address": "8 Willow Court",
    "contact": "studio@stillwater.example",
    "product": "The everyday vessel",
    "detail": "Hand-built stoneware\n12 × 9 cm",
    "course": "Weekend\nhand-building",
    "date": "Saturday · 10am–1pm",
    "price": "$65 · materials included"
  },
  "fonts": [
    {
      "family": "DM Sans",
      "file": "fonts/DM Sans.ttf",
      "licenseFile": "fonts/DM Sans-OFL.txt"
    },
    {
      "family": "Fraunces",
      "file": "fonts/Fraunces.ttf",
      "licenseFile": "fonts/Fraunces-OFL.txt"
    }
  ],
  "assets": [],
  "active": "human-pace",
  "notes": "Voice: calm, concrete and inviting. Never imply that the studio or its objects have therapeutic effects.\nThe mark is a pair of hand-drawn currents; the vessel is a separate original illustration. Keep generous space around the typography.\nUse the warm clay accent to identify the work, and blue for text and the studio signature.\nThe studio and prices are fictional fixture material.",
