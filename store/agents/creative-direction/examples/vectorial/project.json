  "spec": "forme/1",
  "id": "vectorial-consulting",
  "title": "Vectorial — systems consultancy",
  "brief": "A fictional technical consultancy supplies an approved green monogram. Preserve its exact geometry and color. Build a credible launch for engineering leaders: an identity lockup, service overview, talk announcement, proposal cover and contact card. Avoid fake product dashboards, invented clients and unverifiable performance claims.",
  "copy": {
    "name": "Vectorial",
    "category": "Systems, made legible.",
    "tagline": "Clarity is an engineering advantage.",
    "headline": "Make complexity\nlegible.",
    "description": "We help engineering teams untangle systems, map the decisions that matter, and turn a difficult migration into a workable plan.",
    "offer": "Architecture review\nMigration planning\nTechnical facilitation",
    "event": "Designing for the next change",
    "date": "22 October · 17:00 UTC",
    "contact": "hello@vectorial.example",
    "proposal": "Systems review\nScope & approach",
    "edition": "FIELD NOTES / 001"
  },
