    {
      "family": "DM Sans",
      "file": "fonts/DM Sans.ttf",
      "licenseFile": "fonts/DM Sans-OFL.txt"
    },
    {
      "family": "Fraunces",
      "file": "fonts/Fraunces.ttf",
      "licenseFile": "fonts/Fraunces-OFL.txt"
    }
