  "spec": "forme/1",
  "id": "morrow-bakery",
  "title": "Morrow — neighborhood bakery",
  "brief": "A fictional independent bakery is opening its first neighborhood shop. Build a generous, recognizable identity that works on bread bags, opening posters, the menu and the web. It should feel like a daily ritual, never like a luxury patisserie. All copy and illustrations in this fixture were authored for testing.",
  "copy": {
    "name": "Morrow",
    "category": "A neighborhood bakery",
    "tagline": "A little better, every morning.",
    "headline": "Good bread.\nBetter mornings.",
    "description": "Slow dough, early starts, and something warm for the walk home. Bread and pastries, made here every morning.",
    "offer": "Opening weekend\n26–27 September",
    "address": "14 Orchard Lane",
    "contact": "hello@morrow.example",
    "hours": "Tuesday–Sunday · 7am–3pm",
    "note": "Slow dough. Warm hands.\nYour daily loaf.",
    "item-1": "Country sourdough",
    "price-1": "$7",
    "item-2": "Seeded rye",
    "price-2": "$8",
    "item-3": "Morning bun",
    "price-3": "$4",
    "item-4": "Brown butter cookie",
    "price-4": "$3"
  },
