  "assets": [],
  "active": "morning-ritual",
  "notes": "Voice: warm, direct and neighborly. Describe what we make without invented heritage or health claims.\nThe sunrise and doorway share one silhouette: a daily beginning and an open welcome.\nUse ink on paper for longer copy. Reserve the yellow field for moments of recognition. Keep a clear space around the mark equal to one quarter of its height.\nThe shop, address and contact are fictional fixture material. Replace them before a real launch.",
  "website": {
    "title": "{{name}} — {{category}}",
    "cta": "Say hello",
    "href": "mailto:hello@morrow.example",
    "sections": [
      {
        "title": "A loaf worth slowing down for.",
        "text": "Flour, water, salt, time. Our bread starts the day before you do. Pick up your daily loaf, stay for a pastry, and make yourself at home."
      },
      {
        "title": "Come by in the morning.",
        "text": "{{address}}\n{{hours}}"
      }
    ]
  },
