{
  "spec": 1,
  "id": "autonomous/memories",
  "name": "Memories",
  "category": "Code",
  "author": "Autonomous",
  "description": "Browse what every agent on this computer remembers — Claude Code, Codex, Grok Build, Hermes and more — beside a year of your work with them, and build an About You from your own words.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "NOTES.md",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "MEM_CLI": "${dsh}/toolchain/mem",
      "MEMORIES_DSH_DIR": "${dsh}"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "./viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
