#!/usr/bin/env bash
# The agent's hands, and a person's. Picks the Node the package installed against, then runs the CLI.
set -euo pipefail
cd "$(dirname "$0")/.."
. toolchain/runtimes.sh
harness_node 22 >/dev/null || { echo "miss node 22+ is required for Harness Monitor" >&2; exit 1; }
exec node toolchain/hps.mjs "$@"
