{
  "spec": 1,
  "id": "autonomous/harness-monitor",
  "name": "Harness Monitor",
  "category": "Compute",
  "author": "Autonomous",
  "description": "Inspect harnesses across your machines. See workspace and session storage separately, stop work, or review permanent session and Git worktree cleanup.",
  "engine": "opencode",
  "workspace": {
    "template": "template",
    "marker": "NOTES.md",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "HPS_CLI": "${dsh}/toolchain/hps",
      "MONITOR_DSH_DIR": "${dsh}",
      "OPENCODE_CONFIG_CONTENT": "{\"model\":\"opencode/muse-spark-1.3-contributor-free\",\"small_model\":\"opencode/muse-spark-1.3-contributor-free\"}"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "./viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
