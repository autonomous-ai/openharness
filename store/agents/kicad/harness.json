{
  "spec": 1,
  "id": "autonomous/kicad",
  "name": "KiCad",
  "category": "PCB",
  "author": "KiCad",
  "formerly": [
    "autonomous/solder"
  ],
  "description": "Describe a board; get a real KiCad project — a wired schematic, DRC-checked copper, a prototype packet — with a live board view.",
  "engine": "codex",
  "workspace": {
    "template": "upstream/harness/kicad/template",
    "marker": "project.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "upstream/harness/kicad/AGENTS.md",
    "skills": [
      "upstream/harness/kicad/skills"
    ],
    "env": {
      "KICAD_HARNESS_PYTHON": "${dsh}/upstream/harness/kicad/toolchain/python",
      "CIRCUIT_PYTHON": "${dsh}/toolchain/python",
      "KICAD_HARNESS_ROOT": "${dsh}/upstream",
      "KICAD_HARNESS_BLOCKS": "${dsh}/upstream/packages/golden-blocks/blocks",
      "CIRCUIT_TOOLCHAIN": "${dsh}/upstream/toolchain",
      "KICADPY_CLI": "${dsh}/kicad/KiCad.app/Contents/MacOS/kicad-cli",
      "KICADPY_PYTHON": "${dsh}/kicad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3",
      "CIRCUIT_KICAD_CLI": "${dsh}/kicad/KiCad.app/Contents/MacOS/kicad-cli",
      "KICAD_HARNESS_SHARE": "${dsh}/kicad/KiCad.app/Contents/SharedSupport",
      "CIRCUIT_SKILLS_DIR": "${workspace}/.agents/skills",
      "DISABLE_AUTOUPDATER": "1"
    },
    "args": [
      "-m",
      "gpt-6-astra",
      "-c",
      "model_reasoning_effort=high",
      "-c",
      "approval_policy=never",
      "-c",
      "sandbox_mode=danger-full-access",
      "-c",
      "hooks.Stop=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=1200}]}]",
      "-c",
      "hooks.Interrupt=[{hooks=[{type=\"command\",command=\"\\\"$KICAD_HARNESS_PYTHON\\\" -m kicadpy.autofinish\",timeout=3}]}]"
    ]
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/"
  },
  "verdict": ".harness/verdict.json"
}
