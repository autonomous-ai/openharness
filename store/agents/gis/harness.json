{
  "spec": 1,
  "id": "autonomous/gis",
  "name": "GIS",
  "category": "GIS",
  "author": "OpenHarness contributors",
  "description": "Explore GeoJSON in an offline-capable map with search, geometry filters, safe feature inspection, distance measurement and export.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "index.html",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "GIS_SKILLS": "${dsh}/skills"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/isolated-web-viewer",
    "artifactExtensions": [
      ".html"
    ]
  },
  "verdict": ".harness/verdict.json"
}
