# Copy to .env (never commit .env) and fill in.
# Gmail: IMAP over TLS with an app password (Google Account > Security > 2-Step Verification > App passwords).
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
# The 16 letters Google shows, spaces or not.
IMAP_APP_PASSWORD=abcd efgh ijkl mnop
# The folder (Gmail label) to watch. INBOX, or a label such as "Jobs".
IMAP_FOLDER=INBOX
# How often to look for new unseen mail, in seconds (at least 10).
POLL_SECONDS=30
