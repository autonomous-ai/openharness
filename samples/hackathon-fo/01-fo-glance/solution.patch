diff --git a/devices/harness-device/firmware/test/test_glance.c b/devices/harness-device/firmware/test/test_glance.c
new file mode 100644
index 000000000..83882d375
--- /dev/null
+++ b/devices/harness-device/firmware/test/test_glance.c
@@ -0,0 +1,100 @@
+// The glance line (main/ui/habitat/glance.h) and the Focus face that draws it (focus.c, glance_face).
+#include "ui/habitat/glance.h"
+#include "ui/habitat/focus.h"
+#include "ui/habitat/theme.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static void parser(void)
+{
+    ht_glance_t g;
+    // The line from the spec: three numbers shown, the goal kept apart.
+    assert(ht_glance_parse("GLANCE applied=5 replies=2 interviews=1 goal=10", &g));
+    assert(g.count == 3 && g.has_goal && g.goal == 10);
+    assert(!strcmp(g.shown[0].key, "applied") && g.shown[0].value == 5);
+    assert(!strcmp(g.shown[1].key, "replies") && g.shown[1].value == 2);
+    assert(!strcmp(g.shown[2].key, "interviews") && g.shown[2].value == 1);
+    assert(ht_glance_progress(&g) == 5);
+    // Its first line only; and the daemon's recap, which runs the prose after it onto the same line.
+    assert(ht_glance_parse("GLANCE applied=5 goal=10\nToday I sent five applications.", &g) && g.count == 1);
+    assert(ht_glance_parse("GLANCE applied=5 replies=2 goal=10 Today I sent five. Two replied.", &g) && g.count == 2);
+    // Unknown keys are shown as-is; without `applied` the ring counts the first number.
+    assert(ht_glance_parse("GLANCE pages=40 bugs=3 goal=80", &g) && ht_glance_progress(&g) == 40);
+    assert(!strcmp(g.shown[1].key, "bugs") && g.shown[1].value == 3);
+    // No goal: no ring, the numbers still stand. The edges of a value and a key.
+    assert(ht_glance_parse("GLANCE applied=0", &g) && !g.has_goal && g.count == 1 && g.shown[0].value == 0);
+    assert(ht_glance_parse("GLANCE abcdefghijkl=9999", &g) && g.shown[0].value == 9999);
+    // A fourth number is kept (the face shows three).
+    assert(ht_glance_parse("GLANCE a=1 b=2 c=3 d=4", &g) && g.count == 4 && !g.has_goal);
+    // Malformed: the ordinary recap card.
+    assert(!ht_glance_parse("GLANCE a=1 b=2 c=3 d=4 goal=5", &g) && !g.count);   // > 4 pairs
+    assert(!ht_glance_parse("GLANCE Applied=5", &g));                          // capital in the key
+    assert(!ht_glance_parse("GLANCE applied_today=5", &g));                    // not [a-z]
+    assert(!ht_glance_parse("GLANCE abcdefghijklm=1", &g));                    // 13 letters
+    assert(!ht_glance_parse("GLANCE =5", &g));                                 // empty key
+    assert(!ht_glance_parse("GLANCE applied=10000", &g));                      // > 9999
+    assert(!ht_glance_parse("GLANCE applied=99999999999", &g));                // far past it
+    assert(!ht_glance_parse("GLANCE applied=-1", &g));                         // not unsigned
+    assert(!ht_glance_parse("GLANCE applied=5x", &g));
+    assert(!ht_glance_parse("GLANCE applied=", &g));
+    assert(!ht_glance_parse("GLANCE goal=10 goal=12 applied=1", &g));          // two goals
+    assert(!ht_glance_parse("GLANCE goal=10", &g));                            // nothing to show
+    assert(!ht_glance_parse("GLANCE", &g) && !ht_glance_parse("GLANCE ", &g));
+    assert(!ht_glance_parse("glance applied=5", &g));                          // case-sensitive
+    assert(!ht_glance_parse("GLANCEapplied=5", &g));
+    assert(!ht_glance_parse("Shipped it. GLANCE applied=5", &g));             // not at the start
+    assert(!ht_glance_parse("Applied to five jobs today.", &g));
+    assert(!ht_glance_parse("", &g) && !ht_glance_parse(NULL, &g));
+}
+
+static ht_character_face_t face(void)
+{
+    ht_character_face_t f;
+    memset(&f, 0, sizeof f);
+    f.recipient = "Fo job hunt";
+    f.engine = "fo";
+    f.clock_ms = 1200;
+    return f;
+}
+
+static void face_runs(void)
+{
+    static ht_scene_t s;
+    ht_character_face_t f = face();
+    // The glance face: the home face's eleven runs, the ring in the mark's and card's slots.
+    ht_scene_clear(&s, ht_rgb(HT_THEME_FOCUS_CANVAS));
+    ht_focus_face(&s, &f, 0, 0, "GLANCE applied=5 replies=2 interviews=1 goal=10");
+    assert(s.count == 11);
+    assert(s.runs[1].ring.set && s.runs[1].ring.w16 && s.runs[2].ring.set && s.runs[2].ring.w16);
+    assert(s.runs[2].ring.colour == ht_rgb(HT_THEME_ACCENT));
+    assert(!strcmp(s.runs[3].text, "5") && !strcmp(s.runs[4].text, "2") && !strcmp(s.runs[5].text, "1") && !s.runs[6].text[0]);
+    assert(!strcmp(s.runs[7].text, "applied") && !strcmp(s.runs[8].text, "replies") && !strcmp(s.runs[9].text, "interviews"));
+    assert(!strcmp(s.runs[10].text, "5 / 10 applied"));
+    assert(ht_focus_pet_next_ms(&f, "GLANCE applied=5 goal=10") == 0);
+    // Another glance line, fewer numbers and no goal: the same runs, the empty ones empty.
+    ht_scene_clear(&s, ht_rgb(HT_THEME_FOCUS_CANVAS));
+    ht_focus_face(&s, &f, 0, 0, "GLANCE applied=12");
+    assert(s.count == 11 && s.runs[1].ring.set && !s.runs[1].ring.w16 && !s.runs[2].ring.w16);
+    assert(!strcmp(s.runs[3].text, "12") && !s.runs[4].text[0] && !s.runs[8].text[0] && !s.runs[10].text[0]);
+    // Past the goal the ring is full; at zero it is empty.
+    ht_scene_clear(&s, ht_rgb(HT_THEME_FOCUS_CANVAS));
+    ht_focus_face(&s, &f, 0, 0, "GLANCE applied=12 goal=10");
+    assert(s.runs[2].ring.w16 && s.runs[2].ring.cosh == -16384);
+    ht_scene_clear(&s, ht_rgb(HT_THEME_FOCUS_CANVAS));
+    ht_focus_face(&s, &f, 0, 0, "GLANCE applied=0 goal=10");
+    assert(s.runs[1].ring.w16 && !s.runs[2].ring.w16);
+    // A malformed line is an ordinary recap: the card (a box) in its slot, the text on it.
+    ht_scene_clear(&s, ht_rgb(HT_THEME_FOCUS_CANVAS));
+    ht_focus_face(&s, &f, 0, 0, "GLANCE applied=10000 goal=10");
+    assert(s.count == 11 && !s.runs[1].ring.set && s.runs[2].box.h && !s.runs[2].ring.set);
+    assert(strstr(s.runs[3].text, "GLANCE"));
+}
+
+int main(void)
+{
+    parser();
+    face_runs();
+    puts("glance: PASS (parser, fallback, face runs)");
+    return 0;
+}
