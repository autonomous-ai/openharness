diff --git a/devices/harness-device/firmware/main/ui/habitat/glance.h b/devices/harness-device/firmware/main/ui/habitat/glance.h
new file mode 100644
index 000000000..a5187142c
--- /dev/null
+++ b/devices/harness-device/firmware/main/ui/habitat/glance.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/*
+ * THE GLANCE LINE — an agent's recap that is a few numbers instead of a sentence.
+ *
+ *     GLANCE applied=5 replies=2 interviews=1 goal=10
+ *
+ * Case-sensitive, at the very start of the recap. After "GLANCE" come up to four `key=value` pairs
+ * separated by spaces: a key is 1..12 letters a-z, a value an unsigned integer 0..9999. The pairs end at
+ * the end of the line ('\n'), the end of the text, or the first word with no '=' in it — the daemon's
+ * recap (cli/src/lib/deviceRecap.ts) runs the reply's opening sentences together, and recap_preview()
+ * in ui_habitat.c turns line breaks into spaces, so the prose after the line is still on it.
+ *
+ * `goal` is not shown as a number: it is the ring's 100 %. Every other key is shown as-is, the first
+ * three of them. Anything malformed (a fifth pair, a bad key, a value past 9999, no pair to show)
+ * is not a glance, and the face draws the ordinary recap card.
+ *
+ * Header-only and free of the renderer, so the host test (test/test_glance.c) can include it alone.
+ */
+enum { HT_GLANCE_PAIRS = 4, HT_GLANCE_SHOWN = 3, HT_GLANCE_KEY = 12, HT_GLANCE_MAX = 9999 };
+
+typedef struct {
+    char key[HT_GLANCE_KEY + 1];
+    uint16_t value;
+} ht_glance_pair_t;
+
+typedef struct {
+    ht_glance_pair_t shown[HT_GLANCE_PAIRS];   // in order, without `goal`
+    uint8_t count;                              // pairs in `shown` (1..4; the face draws the first three)
+    bool has_goal;
+    uint16_t goal;
+} ht_glance_t;
+
+// One `key=value` word at `p`, `len` bytes. False when it is not one.
+static inline bool ht_glance_pair(const char *p, size_t len, ht_glance_pair_t *out)
+{
+    const char *eq = (const char *)memchr(p, '=', len);
+    if (!eq) return false;
+    size_t klen = (size_t)(eq - p), vlen = len - klen - 1;
+    if (klen < 1 || klen > HT_GLANCE_KEY || vlen < 1 || vlen > 4) return false;
+    for (size_t i = 0; i < klen; i++)
+        if (p[i] < 'a' || p[i] > 'z') return false;
+    unsigned v = 0;
+    for (size_t i = 0; i < vlen; i++) {
+        if (eq[1 + i] < '0' || eq[1 + i] > '9') return false;
+        v = v * 10 + (unsigned)(eq[1 + i] - '0');
+    }
+    if (v > HT_GLANCE_MAX) return false;
+    memcpy(out->key, p, klen);
+    out->key[klen] = 0;
+    out->value = (uint16_t)v;
+    return true;
+}
+
+// True, with `g` filled, when `text` is a glance line; false (and `g` cleared) otherwise.
+static inline bool ht_glance_parse(const char *text, ht_glance_t *g)
+{
+    memset(g, 0, sizeof *g);
+    if (!text || strncmp(text, "GLANCE", 6) || (text[6] != ' ' && text[6] != '\t')) return false;
+    const char *p = text + 6;
+    unsigned pairs = 0;
+    for (;;) {
+        while (*p == ' ' || *p == '\t' || *p == '\r') p++;
+        if (!*p || *p == '\n') break;
+        size_t len = 0;
+        while (p[len] && p[len] != ' ' && p[len] != '\t' && p[len] != '\r' && p[len] != '\n') len++;
+        if (!memchr(p, '=', len)) break;   // prose after the line: the pairs are over
+        ht_glance_pair_t pair;
+        if (++pairs > HT_GLANCE_PAIRS || !ht_glance_pair(p, len, &pair)) goto bad;
+        if (!strcmp(pair.key, "goal")) {
+            if (g->has_goal) goto bad;
+            g->has_goal = true;
+            g->goal = pair.value;
+        } else g->shown[g->count++] = pair;
+        p += len;
+    }
+    if (g->count) return true;
+bad:
+    memset(g, 0, sizeof *g);
+    return false;
+}
+
+// What the ring counts toward the goal: `applied` when the line has it, else its first number.
+static inline uint16_t ht_glance_progress(const ht_glance_t *g)
+{
+    for (unsigned i = 0; i < g->count; i++)
+        if (!strcmp(g->shown[i].key, "applied")) return g->shown[i].value;
+    return g->count ? g->shown[0].value : 0;
+}
