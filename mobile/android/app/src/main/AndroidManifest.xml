<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Without this the app cannot open a socket at all: Android gates the
         syscall on group membership, so bind() fails with EPERM long before any
         address is consulted. Debug and profile builds get it from the manifests
         Flutter generates for devtools, which is why only release broke — the
         sign-in loopback server died on 127.0.0.1 and it read as localhost being
         blocked. Needed here for the relay socket and that loopback alike. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets libwebrtc notice a wifi↔cellular change and restart ICE rather than
         wait out the disconnect grace. Not a runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Joining a new device's setup hotspot (Settings ▸ Add a device): a WifiNetworkSpecifier
         request, which Android confirms with its own sheet. Neither is a runtime permission. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Taking a picture to send to an agent or into a Swarm chat. Picking an EXISTING picture needs
         no permission at all: image_picker goes through ACTION_GET_CONTENT / the
         photo picker, which hands back one item the user chose rather than
         opening the library — hence no READ_MEDIA_IMAGES here. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The camera is how one feature sends a picture, not something the app
         cannot run without: a tablet or emulator with no camera must still
         install and show every other screen. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice input, the terminal's default way to type. The recording is
         transcribed by the Harness backend (`/api/voice/stt`), so the
         microphone is the only permission it needs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application
        android:label="Harness"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- harness://swarm/<tab>/<conversation>/<message>: the message link Desktop's Copy
                 link to message makes. MainActivity hands it to Dart over `harness/links`, which
                 opens the chat at that message; the link names ids only and grants nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harness" android:host="swarm" />
            </intent-filter>
            <!-- Off: a message link goes through `harness/links`, never Flutter's own route push,
                 which this app's navigator has no route for. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
        </activity>
        <!-- "Back to Harness" on the last page of "Continue with Google / Apple": brings the app
             back over the Custom Tab the sign-in ran in, and takes the tab down with it (see
             SignInReturnActivity.kt). It carries nothing and does nothing else, so being
             reachable by any link that names its scheme costs nothing. Its own empty affinity,
             no history and no Recents entry: it is a hop, never a screen. The scheme is
             `signInReturnUrl` in lib/viewer/sign_in_browser.dart. -->
        <activity
            android:name=".SignInReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ai.autonomous.harness.signin" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
