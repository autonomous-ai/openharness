<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Harness</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>harness</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- ⚠️ DECISION, NOT A DEFAULT — and it is currently the OPTIMISTIC one.
	     `false` auto-answers App Store Connect's export-compliance question and
	     is right only for an app whose encryption is the OS's own (an HTTPS
	     call). This app is not that: it terminates its own end-to-end
	     encryption — X25519, ChaCha20-Poly1305 and a CPace PAKE, in `lib/e2ee/`
	     — so the honest answer is very likely `true` plus a self-classification
	     report, or an exemption confirmed with whoever owns export compliance.
	     Getting it wrong is not a build error: review asks, and the version
	     sits still until someone answers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Taking a picture to send to an agent or into a Swarm chat. Picking from
	     the library goes through PHPicker, which runs out of process and grants
	     nothing, and the Swarm chat asks for no metadata, so iOS does not show
	     NSPhotoLibraryUsageDescription today. It is set anyway, in plain words,
	     so a library read that does ask (a future iOS, or a picker option) says
	     why rather than ending the app. -->
	<key>NSCameraUsageDescription</key>
	<string>Scan the code on your computer to connect, or take a photo to send to an agent or a Swarm chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos to send to an agent or a Swarm chat. Harness sees only the photos you pick.</string>
	<!-- What iOS shows when the app first reaches an address on the local network.
	     Computers are reached through the relay, so today that is a backend on a
	     LAN address in development, or the debugger in a debug build. Set here, it
	     also replaces the line Flutter's build puts into Debug and Profile builds
	     ("Allow Flutter tools on your computer to connect…", `xcode_backend.dart`),
	     which only adds its own when the app has none. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the computers running Harness on your local network.</string>
	<!-- Voice input, what tapping a terminal's mic opens. Asked for on the
	     first tap, not at launch. A terminal's recording is transcribed by the
	     Harness backend (`/api/voice/stt`, the dial's own path), not by the OS. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to an agent in a terminal instead of typing.</string>
	<!-- A Swarm chat's mic: the phone's own recognizer, the keyboard's
	     dictation, writes the words into the message box as they are said
	     (`DictationChannel` in AppDelegate.swift). Asked for on its first tap,
	     before the microphone. Refused, the chat records and the backend
	     transcribes, as a terminal does. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Show what you say in a chat's message box as you say it.</string>
	<!-- Save Image and Save Video in the share sheet of a terminal's media
	     preview (`phone/media_preview_page.dart`). Adding to the library is all
	     it does, and iOS ends the app at that button when this string is
	     missing. Reading the library still needs none — see the camera's note. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save pictures and videos from an agent to your photo library.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
